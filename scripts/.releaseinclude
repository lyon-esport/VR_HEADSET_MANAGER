# -------------------------------------------------------
# VR HEADSET MANAGER - Release Include Rules
#
# Lines without ! = INCLUDE
# Lines with !     = EXCLUDE (highest priority, overrides any include)
# Paths are relative to the project root.
# Both / and \ are accepted as separators.
# Wildcards: * matches any characters except \ (no path crossing).
# Folder patterns: /folder/ or /folder/* includes all files recursively.
# -------------------------------------------------------

# --- Never ship the dev/test tooling ---
# Create-ZipRelease.ps1 already hard-excludes scripts\ before reading this
# file. This line is here so the intent is visible in the manifest too, and
# section 10 of the non-regression harness asserts the extracted release
# really has no scripts\ folder.
!/scripts/

# --- Root files ---
/main.ps1
/START_VR_HEADSET_MANAGER.exe
/README.md
/LICENSE.md

# --- Core modules ---
/modules/
# Web route handlers (S9-3): web_routes.ps1 dot-sources every routes\routes_<domain>.ps1 and
# refuses to load when one is missing. Already covered by /modules/ (recursive); listed so
# the dependency is visible. Never exclude it: exclusions win, and the web server would not start.
/modules/Pode_WebServer/routes/

# --- Config template (not the runtime config) ---
/templates/

# --- Website static pages and templates ---
/website/
!/website/timer/
!/website/generated/
!/website/assets/app_icons/


# --- Documentation (exclude scratch/test files) ---
/docs/
!/docs/adr/
!/docs/improvement_plan/
# Only operator documentation of the release ships: design plans and stale copies stay in dev.
!/docs/plans/
!/docs/OLD_README.md
!/docs/test.ps1
!/docs/test_invoke_usb.ps1
!/docs/TODO_AI.txt
!/docs/fr-FR/test.psd1

# --- Sources: explicitly included subfolders ---
/sources/ADB Wireless activator/
# ffmpeg is NEVER part of a release (about 100 MB). Do not add a /sources/ffmpeg line here:
# a fresh install gets it from the first-run wizard (Invoke-FfmpegDownload, option 1) or from
# Configuration > Advanced, and Create-ZipRelease.ps1 refuses to pack sources\ffmpeg* anyway.
/sources/MediaMTX/mediamtx_v1.20.1_windows_amd64/
/sources/scrcpy/scrcpy-win64-v5.0.1/
/sources/sqlite/System.Data.SQLite-1.0.119/

# --- ffmpeg is never shipped (exclusions win over any include above) ---
!/sources/ffmpeg/
!/sources/ffmpeg*
