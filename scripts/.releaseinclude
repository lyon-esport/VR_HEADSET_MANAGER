# -------------------------------------------------------
# VR HEADSET MANAGER - Release Include Rules
#
# Lines without ! = INCLUDE
# Lines with !     = EXCLUDE (highest priority, overrides any include)
# Paths are relative to the project root.
# Both / and \ are accepted as separators.
# Wildcards: * matches any characters except \ (no path crossing).
# Folder patterns: /folder/ or /folder/* includes all files recursively.
# -------------------------------------------------------

# --- Never ship the dev/test tooling ---
# Create-ZipRelease.ps1 already hard-excludes scripts\ before reading this
# file. This line is here so the intent is visible in the manifest too, and
# section 10 of the non-regression harness asserts the extracted release
# really has no scripts\ folder.
!/scripts/

# --- Root files ---
/main.ps1
/START_VR_HEADSET_MANAGER.cmd
/README.md
/LICENSE.md

# --- Core modules ---
/modules/

# --- Config template (not the runtime config) ---
/templates/

# --- Website static pages and templates ---
/website/
!/website/timer/
!/website/generated/
!/website/assets/app_icons/


# --- Documentation (exclude scratch/test files) ---
/docs/
!/docs/test.ps1
!/docs/test_invoke_usb.ps1
!/docs/TODO_AI.txt
!/docs/fr-FR/test.psd1

# --- Sources: explicitly included subfolders ---
/sources/ADB Wireless activator/
/sources/MediaMTX/mediamtx_v1.20.1_windows_amd64/
/sources/scrcpy/scrcpy-win64-v4.1/