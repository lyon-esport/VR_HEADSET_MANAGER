{
  "name": "vrhm-streamdeck-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stream Deck plugin for VR Headset Manager. Build with scripts/Build-StreamDeckPlugin.ps1 (builds outside the shared drive).",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.lyonesport.vrhm\""
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@tsconfig/node20": "20.1.10",
    "@types/node": "24.1.0",
    "rollup": "4.68.0",
    "tslib": "2.9.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4"
  }
}
