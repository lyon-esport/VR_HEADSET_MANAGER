<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
	<meta http-equiv="refresh" content="5" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= $name  %> VR Headset - Status</title>

    <style>
      :root {
        --text: #e5e7eb;     /* light gray */
        --accent: #60a5fa;   /* blue */
        --muted: #94a3b8;    /* blue-gray */
      }
      * { box-sizing: border-box; }
      html, body {
        height: 100%;
        margin: 0;
        background: transparent !important; /* key for OBS */
        color: var(--text);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
      }
      .wrap {
        min-height: 100%;
        display: grid;
        place-items: center;
        padding: 31px 25px;
      }
      .card {
        width: min(749px, 74vw);
        background: transparent;  /* no background for overlay */
        border: none;
        border-radius: 16px;
        padding: 36px 34px;
        box-shadow: none;
        backdrop-filter: none;
        text-align: center;
      }
      .title {
        margin: 0 0 21px 0;
        font-size: clamp(36px, 6.5vw, 49px);
        font-weight: 800;
        letter-spacing: 0.6px;
        color: var(--accent);
        text-shadow: 0 2px 8px rgba(0,0,0,0.35);
      }
      .values {
        font-size: clamp(31px, 5.85vw, 44px);
        line-height: 1.3;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        text-shadow: 0 2px 6px rgba(0,0,0,0.35);
      }

      /* Common styles */
      .batt, .temp {
        display: inline-flex;
        align-items: center;
        gap: 13px;
        padding: 13px 18px;
        border-radius: 999px;
        border: 1px solid transparent;
        color: #fff; /* text always white by default */
      }
      .batt .emoji, .temp .emoji {
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
      }
      .muted { color: var(--muted); font-weight: 500; }

      /* Battery states (background/border only, text stays white) */
      .batt--low {                       /* <= 30%: red */
        background: rgba(239, 68, 68, 0.18);
        border-color: rgba(239, 68, 68, 0.35);
		color: red;
      }
      .batt--mid {                       /* 31-59%: orange */
        background: rgba(245, 158, 11, 0.18);
        border-color: rgba(245, 158, 11, 0.35);
		color: orange;
      }
      .batt--ok {                        /* >= 60%: blue (current style) */
        background: rgba(96, 165, 250, 0.12);
        border-color: rgba(96, 165, 250, 0.25);
		color: white;
      }

      /* Normal temperature (blue) */
      .temp {
        background: rgba(96,165,250,0.12);
        border-color: rgba(96,165,250,0.25);
		color: white;
      }
      /* Hot temperature > 50 °C: red background + text */
      .temp--hot {
        background: rgba(239, 68, 68, 0.20);
        border-color: rgba(239, 68, 68, 0.45);
        color: red;
      }

      /* Device icon row: left controller, headset, right controller */
      .device-icons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 26px;
        margin: 13px 0 18px;
      }
      .device-icon {
        height: clamp(47px, 7.15vw, 68px);
        width: auto;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <main class="card" role="main" aria-label="Status <%= $name %>">
        <h1 class="title"><%= $name %>
           <span class="muted">
            <% if (-not $ping) { %>☠️<% } elseif ( ($temp -gt $temperature_highLevel) -or ($battery -lt $headset_battery_criticalLevel) -or (-not $charging) ) { %>⚠️<% } else { %>✅<% } %>
        </span>
        </h1>
<%
  # Determine headset icon color based on ping and battery level
  if (-not $ping) {
    $headsetIconColor = "UNAVAILABLE"
  } elseif ($battery -eq "-") {
    $headsetIconColor = "WHITE"
  } elseif ($battery -lt $headset_battery_criticalLevel) {
    $headsetIconColor = "RED"
  } elseif ($battery -lt $headset_battery_warningLevel) {
    $headsetIconColor = "ORANGE"
  } else {
    $headsetIconColor = "GREEN"
  }

  # Determine left controller icon color based on battery level
  if ($battery_ctrl_left -eq "-") {
    $ctrlLeftColor = "GREY"
  } elseif ($battery_ctrl_left -lt $controllers_battery_criticalLevel) {
    $ctrlLeftColor = "RED"
  } elseif ($battery_ctrl_left -lt $controllers_battery_warningLevel) {
    $ctrlLeftColor = "ORANGE"
  } else {
    $ctrlLeftColor = "GREEN"
  }

  # Determine right controller icon color based on battery level
  if ($battery_ctrl_right -eq "-") {
    $ctrlRightColor = "GREY"
  } elseif ($battery_ctrl_right -lt $controllers_battery_criticalLevel) {
    $ctrlRightColor = "RED"
  } elseif ($battery_ctrl_right -lt $controllers_battery_warningLevel) {
    $ctrlRightColor = "ORANGE"
  } else {
    $ctrlRightColor = "GREEN"
  }

  # URL-encode model name for use in asset path (e.g., 'Quest 3' -> 'Quest%203')
  $assetModelPath = if ($model -and $model -ne "-") { [System.Uri]::EscapeDataString($model) } else { "" }

  # Compute time display string from time_remaining_min
  $timeDisplay = ""
  if ($time_remaining_min -and $time_remaining_min -ne "") {
    $_tm = [int]$time_remaining_min
    $_th = [math]::Floor($_tm / 60)
    $_tmm = $_tm % 60
    $timeDisplay = if ($_th -gt 0) { "${_th}h ${_tmm}m" } else { "${_tmm}m" }
  }
%>
<% if ($assetModelPath) { %>
        <div class="device-icons" aria-label="Device hardware status">
          <img src="assets/<%= $assetModelPath %>/Ctrl_Left_<%= $ctrlLeftColor %>.png"
               alt="Left Controller - <%= $ctrlLeftColor %>" class="device-icon" />
          <img src="assets/<%= $assetModelPath %>/Headset_<%= $headsetIconColor %>.png"
               alt="Headset - <%= $headsetIconColor %>" class="device-icon" />
          <img src="assets/<%= $assetModelPath %>/Ctrl_Right_<%= $ctrlRightColor %>.png"
               alt="Right Controller - <%= $ctrlRightColor %>" class="device-icon" />
        </div>
<% } %>
        <div class="values" aria-live="polite">
          <span class="batt" aria-label="Battery percentage">
            <span class="emoji" aria-hidden="true">
            <% if ($battery -lt $headset_battery_criticalLevel) { %>🪫<% } else { %>🔋<% } %>
            </span>
            <strong><%= $battery %> %</strong>
            <span class="muted">
              <% if ($charging) { %>⚡<% } else { %>🚫<% } %>
            </span>
            <% if ($timeDisplay) { %><span class="muted" style="font-size:0.75em;margin-left:4px">~<%= $timeDisplay %></span><% } %>
          </span>
          <span class="temp" aria-label="Temperature in Celsius">
            <span class="emoji" aria-hidden="true">
              <% if ($temp -gt $temperature_highLevel) { %>🔥<% } else { %>❄️<% } %>
            </span>
            <strong><%= $temp %>&nbsp;°C</strong>
          </span>
        </div>
      </main>
    </div>

    <script>
      function applyBatteryClass() {
        const batt = document.querySelector('.batt');
        if (!batt) return;

        const strong = batt.querySelector('strong');
        if (!strong) return;

        const num = parseInt((strong.textContent || '').replace(/\D/g, ''), 10);
        if (isNaN(num)) return;

        batt.classList.remove('batt--low', 'batt--mid', 'batt--ok');

        if (num <= <%= $headset_battery_criticalLevel %>) {
          batt.classList.add('batt--low');   // red
        } else if (num < <%= $headset_battery_warningLevel %>) {
          batt.classList.add('batt--mid');   // orange
        } else {
          batt.classList.add('batt--ok');    // blue
        }
      }

      function applyTempClass() {
        const temp = document.querySelector('.temp');
        if (!temp) return;

        const strong = temp.querySelector('strong');
        if (!strong) return;

        // Ex: "52 °C" -> 52
        const t = parseInt((strong.textContent || '').replace(/\D/g, ''), 10);
        if (isNaN(t)) return;

        temp.classList.toggle('temp--hot', t > <%= $temperature_highLevel %> );
      }

      // On load
      document.addEventListener('DOMContentLoaded', () => {
        applyBatteryClass();
        applyTempClass();
      });

      // Watch for dynamic changes
      const battTarget = document.querySelector('.batt strong');
      if (battTarget) {
        const moBatt = new MutationObserver(applyBatteryClass);
        moBatt.observe(battTarget, { characterData: true, childList: true, subtree: true });
      }

      const tempTarget = document.querySelector('.temp strong');
      if (tempTarget) {
        const moTemp = new MutationObserver(applyTempClass);
        moTemp.observe(tempTarget, { characterData: true, childList: true, subtree: true });
      }
    </script>
  </body>
</html>
