<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title><%= $name %> - Live Video</title>

    <style>
      /* Full-viewport transparent layout for OBS browser source */
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%; height: 100%;
        background: transparent !important;
        overflow: hidden;
      }

      /* Video element fills the entire viewport */
      #stream {
        width: 100%; height: 100%;
        object-fit: contain;
        background: #000;
        display: block;
      }

      /* Status message shown while connecting or on error - centered */
      #status {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        color: rgba(255, 255, 255, 0.55);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        font-size: 20px;
        text-align: center;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
        pointer-events: none;
        display: none;
      }

      /* Hover action buttons - top-right corner */
      #actions {
        position: absolute;
        top: 10px; right: 10px;
        z-index: 40;
        display: flex;
        flex-direction: column;
        gap: 5px;
        opacity: 0;
        transition: opacity 0.15s;
      }
      body:hover #actions { opacity: 1; }
      .action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px; height: 34px;
        border-radius: 7px;
        background: rgba(0,0,0,0.60);
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.80);
        cursor: pointer;
        text-decoration: none;
        font-family: inherit;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .action-btn:hover { background: rgba(59,130,246,0.80); color: #fff; border-color: rgba(59,130,246,0.6); }
      .action-btn.active { background: rgba(59,130,246,0.55); color: #fff; border-color: rgba(59,130,246,0.6); }

      /* Monitoring overlay - sized/positioned by JS over the actual video rect */
      #monitoring-overlay {
        display: none;
        position: absolute;
        z-index: 30;
        overflow: hidden;
        border-radius: 0 0 3px 0;
      }
      #monitoring-overlay.visible { display: block; }
      #monitoring-overlay iframe {
        position: absolute;
        top: 0; left: 0;
        border: none;
        pointer-events: none;
        transform-origin: top left;
      }
    </style>
  </head>
  <body>
    <video id="stream" autoplay muted playsinline></video>
    <div id="status"></div>

    <div id="actions">
      <!-- Fullscreen -->
      <button class="action-btn" id="btn-fullscreen" title="Fullscreen" aria-label="Fullscreen" onclick="toggleFullscreen()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/>
          <line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
      </button>
      <!-- Monitoring overlay -->
      <button class="action-btn" id="btn-monitoring" title="Show monitoring" aria-label="Show monitoring" onclick="toggleMonitoring()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
      </button>
    </div>

    <div id="monitoring-overlay">
      <iframe src="<%= $display_name %>[monitoring].html" scrolling="no" allow="autoplay"></iframe>
    </div>

    <script>
      // -----------------------------------------------------------------------
      // WHEP (WebRTC HTTP Egress Protocol) player for mediamtx
      // Uses window.location.hostname so it works from any LAN client without
      // hardcoding localhost. Falls back to localhost when opened as a local file.
      // Stream URL: http://{host}:{webrtcPort}/{streamPath}/whep
      // mediamtx starts ffmpeg on-demand when this page connects.
      // -----------------------------------------------------------------------

      // EPS-rendered constants (baked into HTML at generation time)
      var WHEP_HOST = window.location.hostname || 'localhost';
      var WHEP_URL = 'http://' + WHEP_HOST + ':<%= $mediamtx_webrtc_port %>/<%= $stream_path %>/whep';
      var RETRY_DELAY_MS = 5000;   // retry interval when stream is unavailable

      var videoEl  = document.getElementById('stream');
      var statusEl = document.getElementById('status');
      var pc = null;
      var retryTimer = null;

      function showStatus(msg) {
        if (msg) {
          statusEl.textContent = msg;
          statusEl.style.display = 'block';
        } else {
          statusEl.style.display = 'none';
          statusEl.textContent = '';
        }
      }

      function cleanup() {
        if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
        if (pc) {
          pc.oniceconnectionstatechange = null;
          pc.ontrack = null;
          try { pc.close(); } catch (_) {}
          pc = null;
        }
      }

      function scheduleRetry() {
        cleanup();
        showStatus('Stream unavailable - retrying...');
        retryTimer = setTimeout(connect, RETRY_DELAY_MS);
      }

      async function connect() {
        cleanup();
        showStatus('Connecting...');
        try {
          pc = new RTCPeerConnection();

          // Request video (and audio if available) from mediamtx
          pc.addTransceiver('video', { direction: 'recvonly' });
          try { pc.addTransceiver('audio', { direction: 'recvonly' }); } catch (_) {}

          // Attach the incoming stream to the <video> element
          pc.ontrack = function(evt) {
            if (evt.streams && evt.streams[0]) {
              videoEl.srcObject = evt.streams[0];
              showStatus('');
            }
          };

          // Reconnect automatically if the ICE connection drops
          pc.oniceconnectionstatechange = function() {
            var s = pc.iceConnectionState;
            if (s === 'failed' || s === 'disconnected' || s === 'closed') {
              scheduleRetry();
            }
          };

          // Create SDP offer
          var offer = await pc.createOffer();
          await pc.setLocalDescription(offer);

          // Wait for ICE candidate gathering (with a safety timeout)
          await new Promise(function(resolve) {
            if (pc.iceGatheringState === 'complete') { resolve(); return; }
            pc.onicegatheringstatechange = function() {
              if (pc.iceGatheringState === 'complete') resolve();
            };
            setTimeout(resolve, 4000);
          });

          // POST the SDP offer to the mediamtx WHEP endpoint
          var res = await fetch(WHEP_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/sdp' },
            body: pc.localDescription.sdp
          });

          if (!res.ok) {
            throw new Error('WHEP response: ' + res.status);
          }

          var sdpAnswer = await res.text();
          await pc.setRemoteDescription({ type: 'answer', sdp: sdpAnswer });

        } catch (err) {
          scheduleRetry();
        }
      }

      // Start as soon as the DOM is ready
      document.addEventListener('DOMContentLoaded', function() {
        connect();
        // Hide action buttons when embedded in an iframe (e.g. video_monitor.html)
        if (window.self !== window.top) {
          document.getElementById('actions').style.display = 'none';
        }
      });

      // ---- Action buttons ----
      function toggleFullscreen() {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(function() {});
          document.getElementById('btn-fullscreen').classList.add('active');
        } else {
          document.exitFullscreen();
          document.getElementById('btn-fullscreen').classList.remove('active');
        }
      }
      document.addEventListener('fullscreenchange', function() {
        var btn = document.getElementById('btn-fullscreen');
        if (btn) btn.classList.toggle('active', !!document.fullscreenElement);
      });

      var _monitoringVisible = false;

      // Natural render dimensions of the monitoring iframe (must match headset_status template)
      var NATURAL_W = 480;
      var NATURAL_H = 350;

      // Compute the actual rendered video rect inside the viewport (object-fit: contain letterboxing)
      function getVideoDisplayRect() {
        var vw = videoEl.videoWidth;
        var vh = videoEl.videoHeight;
        var cw = window.innerWidth;
        var ch = window.innerHeight;
        if (!vw || !vh) return { left: 0, top: 0, width: cw, height: ch };
        var scale = Math.min(cw / vw, ch / vh);
        var w = vw * scale;
        var h = vh * scale;
        return { left: (cw - w) / 2, top: (ch - h) / 2, width: w, height: h };
      }

      // Position and scale the monitoring overlay over the top-left corner of the video
      function positionMonitoringOverlay() {
        var overlay = document.getElementById('monitoring-overlay');
        if (!overlay) return;
        var rect     = getVideoDisplayRect();
        var wrapperW = rect.width / 3;
        var wrapperH = wrapperW * (NATURAL_H / NATURAL_W);
        overlay.style.left   = rect.left + 'px';
        overlay.style.top    = rect.top  + 'px';
        overlay.style.width  = wrapperW  + 'px';
        overlay.style.height = wrapperH  + 'px';
        var iframe = overlay.querySelector('iframe');
        if (iframe) {
          var s = wrapperW / NATURAL_W;
          iframe.style.width           = NATURAL_W + 'px';
          iframe.style.height          = NATURAL_H + 'px';
          iframe.style.transform       = 'scale(' + s + ')';
          iframe.style.transformOrigin = 'top left';
        }
      }

      function toggleMonitoring() {
        _monitoringVisible = !_monitoringVisible;
        var overlay = document.getElementById('monitoring-overlay');
        var btn     = document.getElementById('btn-monitoring');
        overlay.classList.toggle('visible', _monitoringVisible);
        btn.classList.toggle('active', _monitoringVisible);
        if (_monitoringVisible) positionMonitoringOverlay();
      }

      window.addEventListener('resize', function() {
        if (_monitoringVisible) positionMonitoringOverlay();
      });

      // Re-position when video dimensions become known (stream connects)
      videoEl.addEventListener('loadedmetadata', function() {
        if (_monitoringVisible) positionMonitoringOverlay();
      });

      // Reload monitoring iframe when the file changes (Last-Modified polling)
      var _monLastModified = null;
      var MON_URL = '<%= $display_name %>[monitoring].html';
      setInterval(function() {
        fetch(MON_URL, { method: 'HEAD', cache: 'no-store' })
          .then(function(r) {
            var lm = r.headers.get('Last-Modified') || r.headers.get('ETag') || '';
            if (lm && lm !== _monLastModified) {
              _monLastModified = lm;
              var iframe = document.querySelector('#monitoring-overlay iframe');
              if (iframe) iframe.src = MON_URL + '?_=' + Date.now();
            }
          })
          .catch(function() {});
      }, 5000);
    </script>
  </body>
</html>
