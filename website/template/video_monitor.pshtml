<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VR Headsets - Video Monitor</title>
  <link rel="stylesheet" href="assets/topbar.css">
  <script src="assets/topbar.js"></script>
  <style>
    /* --------- Configuration --------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    :root {
      --min-video-w:        640px;  /* minimum width per video cell */
      --grid-gap:           6px;
      --bg:                 #111;
      --dot-all:            #444;
      --dot-ping:           #22c55e;
      --dot-stream:         #3b82f6;
      --muted:              #333;
    }
    /* --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background: var(--bg);
      min-height: 100vh;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      overflow: hidden;
    }

    .dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .dot-all    { background: var(--dot-all); }
    .dot-ping   { background: var(--dot-ping); }
    .dot-stream { background: var(--dot-stream); }
    .badge {
      font-size: 10px;
      font-weight: 700;
      opacity: 0.65;
    }

    /* Right section */
    .topbar-right {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      margin-left: auto;
    }
    #last-update {
      padding: 0 14px;
      color: var(--muted);
      font-size: 11px;
      white-space: nowrap;
    }

    /* Video grid - flexbox so streaming and offline tiles can have different sizes */
    .grid {
      display: flex;
      flex-wrap: wrap;
      gap: var(--grid-gap);
      padding: var(--grid-gap);
      align-content: flex-start;
      align-items: flex-start;
    }

    /* Cell - streaming (default) - width set dynamically by applyLayout() */
    .cell {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #000;
      border-radius: 3px;
      container-type: size;
      flex: 0 0 auto;
      min-width: 0;
      max-width: 100%;
      order: 0;
    }
    .cell.hidden { display: none; }

    /* Compact offline tile - no video stream, monitoring frame fills cell */
    .cell.no-stream {
      flex: 0 0 auto;
      width: min(240px, 100%);
      aspect-ratio: unset;
      order: 1;
    }
    .cell.no-stream .video-frame    { display: none; }
    .cell.no-stream .status-wrapper { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 3px; }
    .cell.no-stream .cell-actions   { opacity: 1; }
    .cell.no-stream .running-app    { display: none !important; }

    /* Flex row-break: forces streaming cells into their own row above offline tiles */
    .stream-break { order: 0; flex: 0 0 100%; height: 0; }

    /* Full-cell video iframe */
    .video-frame {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      border: none;
    }

    /* Status PiP wrapper - top-left, 1/3 of cell width, 16:9 */
    .status-wrapper {
      position: absolute;
      top: 0; left: 0;
      overflow: hidden;
      z-index: 10;
      border-radius: 0 0 3px 0;
    }
    /* Rendered at NATURAL_W x NATURAL_H, scaled by JS */
    .status-frame {
      position: absolute;
      top: 0; left: 0;
      border: none;
      pointer-events: none;
      transform-origin: top left;
    }

    /* Hide status overlays when toggle is off */
    .status-hidden .status-wrapper { display: none; }
    .status-hidden .running-app    { display: none; }

    /* Running app badge - top center */
    .running-app {
      position: absolute;
      top: 1.2%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 15;
      max-width: 60%;
      background: rgba(0,0,0,0.58);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 20px;
      padding: 0.4% 1.4%;
      display: flex;
      align-items: center;
      pointer-events: none;
      white-space: nowrap;
      overflow: hidden;
    }
    .running-app-name {
      font-size: 1.8cqw;
      font-weight: 700;
      color: rgba(255,255,255,0.90);
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .running-app:empty { display: none; }
    .running-app.hidden { display: none; }

    /* Cell action buttons - top-right corner */
    .cell-actions {
      position: absolute;
      top: 8px; right: 8px;
      z-index: 30;
      display: flex;
      flex-direction: column;
      gap: 4px;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .cell:hover .cell-actions { opacity: 1; }
    .cell-action-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px; height: 30px;
      border-radius: 6px;
      background: rgba(0,0,0,0.55);
      border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.70);
      cursor: pointer;
      text-decoration: none;
      font-family: inherit;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .cell-action-btn:hover { background: rgba(59,130,246,0.75); color: #fff; border-color: rgba(59,130,246,0.6); }
    .cell-action-btn.ar-on { background: rgba(34,197,94,0.28); color: #22c55e; border-color: rgba(34,197,94,0.5); }
    .cell-action-btn.ar-on:hover { background: rgba(34,197,94,0.50); }

    /* Timer overlay - white text at bottom center of the cell */
    .timer-overlay {
      position: absolute;
      bottom: 8%;
      left: 50%;
      transform: translateX(-50%);
      color: #fff;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      font-size: 6cqw;
      font-weight: 700;
      text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      pointer-events: none;
      display: none;
      white-space: nowrap;
      z-index: 25;
      letter-spacing: 0.03em;
    }
    .timer-overlay.visible { display: block; }
    .timer-hidden .timer-overlay { display: none !important; }

    /* Timer control button - bottom-left of cell, hourglass icon, only when timer is visible */
    .cell-timer-btn {
      display: none;
      position: absolute;
      bottom: 6px;
      left: 6px;
      z-index: 30;
      touch-action: manipulation;
      width: 5.5cqw;
      height: 5.5cqw;
      min-width: 22px;
      min-height: 22px;
      border-radius: 6px;
      background: rgba(0,0,0,0.60);
      border: 1px solid rgba(255,255,255,0.15);
      color: rgba(255,255,255,0.80);
      cursor: pointer;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: background 0.12s, color 0.12s, border-color 0.12s;
    }
    .cell-timer-btn svg { width: 40%; height: 40%; display: block; }
    .cell-timer-btn:hover { background: rgba(59,130,246,0.75); color: #fff; border-color: rgba(59,130,246,0.6); }
    .cell-timer-btn.running { background: rgba(239,68,68,0.45); border-color: rgba(239,68,68,0.6); color: #f87171; }
    .cell-timer-btn.running:hover { background: rgba(239,68,68,0.65); border-color: rgba(239,68,68,0.8); }
    .cell-timer-btn.paused  { background: rgba(234,179,8,0.40);  border-color: rgba(234,179,8,0.6);  color: #fbbf24; }
    .cell-timer-btn.paused:hover  { background: rgba(234,179,8,0.60);  border-color: rgba(234,179,8,0.8); }
    .timer-hidden .cell-timer-btn { display: none !important; }

    /* Offline dimming overlay */
    .offline-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.60);
      z-index: 20;
      display: none;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.35);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.08em;
      pointer-events: none;
    }
    .cell.offline .offline-overlay { display: flex; }
    /* In no-stream mode the OFFLINE label sits behind the monitoring frame */
    .cell.no-stream .offline-overlay { z-index: 5; }

    /* Override topbar-filters for this page: shrink to content, allow dropdowns to escape */
    .topbar-filters { flex: 0 0 auto; overflow: visible; }

    /* ------ Headsets filter dropdown ------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    .headsets-filter-dropdown { position: relative; flex-shrink: 0; }
    .headsets-filter-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px 4px 12px; border-radius: 20px; border: 1px solid transparent;
      cursor: pointer; font-size: 12px; font-weight: 600;
      background: var(--filter-idle-bg); color: var(--filter-idle-txt);
      transition: background 0.15s, color 0.15s; white-space: nowrap; font-family: inherit;
    }
    .headsets-filter-btn:hover { background: #242424; color: #888; }
    .headsets-filter-btn.open  { background: #242424; color: #aaa; }
    .headsets-filter-btn.has-hidden { background: rgba(59,130,246,0.15); color: #60a5fa; border-color: rgba(59,130,246,0.3); }
    .headsets-filter-btn .hf-chevron { opacity: 0.4; transition: transform 0.15s; }
    .headsets-filter-btn.open .hf-chevron { transform: rotate(180deg); }
    .headsets-filter-panel {
      display: none; position: fixed;
      min-width: 160px; background: var(--drop-bg); border: 1px solid var(--drop-border);
      border-radius: 6px; box-shadow: 0 10px 30px rgba(0,0,0,0.6); z-index: 300; padding: 4px 0;
    }
    .headsets-filter-panel.open { display: block; }
    .headsets-filter-item {
      display: flex; align-items: center; gap: 9px;
      width: 100%; padding: 7px 13px; background: transparent; border: none;
      color: #888; font-size: 13px; font-family: inherit; text-align: left; cursor: pointer;
      transition: background 0.1s, color 0.1s;
    }
    .headsets-filter-item:hover { background: var(--drop-item-hover); color: #ddd; }
    .headsets-filter-item .hf-check { width: 13px; flex-shrink: 0; opacity: 0; }
    .headsets-filter-item.checked .hf-check { opacity: 1; color: var(--filter-active-bg); }
    .headsets-filter-item.offline { opacity: 0.45; }
    [data-theme="light"] .headsets-filter-btn:hover { background: #e5e5e5; color: #333; }
    [data-theme="light"] .headsets-filter-btn.open  { background: #f0f0f0; color: #111; }
    [data-theme="light"] .headsets-filter-item { color: #555; }
    [data-theme="light"] .headsets-filter-item:hover { color: #111; }
    [data-theme="light"] .headsets-filter-panel { box-shadow: 0 10px 30px rgba(0,0,0,0.12); }

    /* ------ Light mode --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    [data-theme="light"] {
      --bg:    #eaeaea;
      --muted: #999;
    }
    [data-theme="light"] .cell                           { background: #c8c8c8; }
    [data-theme="light"] .running-app                    { background: rgba(255,255,255,0.72); border-color: rgba(0,0,0,0.10); }
    [data-theme="light"] .running-app-name               { color: rgba(0,0,0,0.85); }
    [data-theme="light"] .cell-action-btn                { background: rgba(255,255,255,0.65); color: rgba(0,0,0,0.55); border-color: rgba(0,0,0,0.12); }
    [data-theme="light"] .cell-action-btn:hover          { background: rgba(59,130,246,0.75); color: #fff; border-color: rgba(59,130,246,0.6); }
    [data-theme="light"] .cell-action-btn.ar-on          { background: rgba(34,197,94,0.20); color: #16a34a; border-color: rgba(34,197,94,0.4); }
  </style>
</head>
<body>

  <header class="topbar">

    <!-- Left: brand -->
    <script>document.write(TopBar.brandHTML)</script>

    <div class="v-sep"></div>

    <!-- Compact headset picker (shown when topbar overflows) -->
    <script>document.write(TopBar.compactDropdownHTML)</script>

    <!-- Center: preset filters + headsets dropdown (per-headset buttons injected by JS) -->
    <div class="topbar-filters" id="headset-toggles">
      <span class="filter-label">Show:</span>
      <script>document.write(TopBar.filtersHTML)</script>
    </div>

    <!-- Overlay toggles: always visible even in compact mode -->
    <div class="topbar-overlay-toggles" id="overlay-toggles">
      <div class="v-sep" style="margin: 8px 0; align-self: stretch;"></div>
      <button class="actions-btn" id="status-toggle" title="Toggle status overlay">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        <span class="topbar-btn-label">Status</span>
      </button>
      <button class="actions-btn" id="timer-toggle" title="Toggle timer overlay">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <span class="topbar-btn-label">Timer</span>
      </button>
    </div>

    <!-- Right: shared Config dropdown -->
    <div class="topbar-right">
      <script>document.write(TopBar.monitoringBtnHTML)</script>
      <script>document.write(TopBar.manageDevicesBtnHTML)</script>
      <script>document.write(TopBar.configMenuHTML)</script>
    </div>

  </header>

  <div class="grid" id="grid">
<% foreach ($headset in $headsets) { %>
    <div class="cell" data-name="<%= $headset.name %>" data-display="<%= $headset.displayName %>">
      <iframe class="video-frame"   src="<%= $headset.displayName %>[video].html"      allow="autoplay" scrolling="no"></iframe>
      <div class="status-wrapper">
        <iframe class="status-frame" src="<%= $headset.displayName %>[monitoring].html" scrolling="no"></iframe>
      </div>
      <div class="cell-actions">
        <a class="cell-action-btn" href="<%= $headset.displayName %>[video].html" target="_blank" title="Open fullscreen" aria-label="Open fullscreen">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/>
            <line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
          </svg>
        </a>
        <button class="cell-action-btn autorestart-btn" data-cell-headset="<%= $headset.displayName %>" title="Auto-restart scrcpy: OFF" aria-label="Toggle auto-restart">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.55"/>
          </svg>
        </button>
        <a class="cell-action-btn" href="headset_settings.html?headset=<%= $headset.displayName %>" title="Headset settings" aria-label="Headset settings">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
            <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
          </svg>
        </a>
        <button class="cell-action-btn launch-app-btn" data-launch-app="<%= $headset.displayName %>" title="Launch app" aria-label="Launch app">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </button>
      </div>
      <div class="running-app hidden" data-running-app="<%= $headset.displayName %>">
        <span class="running-app-name"></span>
      </div>
      <div class="timer-overlay" data-timer-cell="<%= $headset.id %>"></div>
      <button class="cell-timer-btn" data-timer-cell="<%= $headset.id %>" title="Start timer (long press: reset)" aria-label="Timer control">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 2h14M5 22h14M7 2v5l5 5-5 5v5M17 2v5l-5 5 5 5v5"/>
        </svg>
      </button>
      <div class="offline-overlay">OFFLINE</div>
    </div>
<% } %>
  <div class="stream-break"></div>
  </div>

  <!-- Launch app modal -->

  <script>
    // ------ Configuration ------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    var CSV_PATH      = '../data/known_headsets_infos.csv';
    var CSV_DELIMITER = ';';
    var REFRESH_MS    = 5000;   // CSV poll interval in ms
    var NATURAL_W     = 480;    // natural render width of the status iframe
    var NO_STREAM_W   = 240;    // CSS width of offline tile (matches min() in .cell.no-stream)    // natural render width of the status iframe
    var NATURAL_H     = 260;    // fallback render height of the status iframe
    var naturalHeights = {};    // detected per-headset content height in px
    // ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

    var HEADSETS_CSV_PATH = '../data/known_headsets.csv';
    var headsetStatus = {};
    var autoRestartState = {};
    var appNameCache = {};
    var initialFilterApplied = false;

    // ------ Per-headset visibility toggles ------------------------------------------------------------------------------------------------------------------------------
    var headsetVisible = {};

    TopBar.initFilters(function(f) {
      Object.keys(headsetVisible).forEach(function(dn) {
        var stat = headsetStatus[dn] || { ping: false, scrcpy: false };
        var show = true;
        if (f === 'online')  show = stat.ping;
        if (f === 'scrcpy')  show = stat.scrcpy;
        if (f === 'offline') show = !stat.ping;
        setHeadsetVisible(dn, show);
      });
    });

    var CHECK_SVG_HF =
      '<svg class="hf-check" width="12" height="12" viewBox="0 0 24 24" fill="none"' +
      ' stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">' +
      '<polyline points="20 6 9 17 4 12"/></svg>';

    var CHEVRON_SVG_HF =
      '<svg class="hf-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none"' +
      ' stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">' +
      '<polyline points="6 9 12 15 18 9"/></svg>';

    function buildHeadsetToggles() {
      var container = document.getElementById('headset-toggles');

      // Build a "Headsets" dropdown after the preset filter buttons
      var wrapper = document.createElement('div');
      wrapper.className = 'headsets-filter-dropdown';
      wrapper.id = 'headsets-filter-dropdown';

      var toggleBtn = document.createElement('button');
      toggleBtn.className = 'headsets-filter-btn';
      toggleBtn.id = 'headsets-filter-btn';
      toggleBtn.innerHTML = 'Headsets ' + CHEVRON_SVG_HF;
      wrapper.appendChild(toggleBtn);

      var panel = document.createElement('div');
      panel.className = 'headsets-filter-panel';
      panel.id = 'headsets-filter-panel';
      wrapper.appendChild(panel);

      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn   = cell.dataset.display;
        var name = cell.dataset.name || dn;
        headsetVisible[dn] = true;

        var item = document.createElement('button');
        item.className = 'headsets-filter-item checked';
        item.dataset.headset = dn;
        item.innerHTML = CHECK_SVG_HF + name;
        item.addEventListener('click', function(e) {
          e.stopPropagation();
          setHeadsetVisible(dn, !headsetVisible[dn]);
          var allOn = Object.keys(headsetVisible).every(function(k) { return headsetVisible[k]; });
          if (allOn) { TopBar.setActiveFilter('all'); }
          else { TopBar.clearPresetFilters(); }
        });
        panel.appendChild(item);
      });

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = panel.classList.toggle('open');
        toggleBtn.classList.toggle('open', open);
        if (open) {
          var r = toggleBtn.getBoundingClientRect();
          panel.style.top  = (r.bottom + 2) + 'px';
          panel.style.left = r.left + 'px';
        }
      });
      document.addEventListener('click', function() {
        panel.classList.remove('open');
        toggleBtn.classList.remove('open');
      });

      container.appendChild(wrapper);

      // Also add per-headset items to the compact dropdown (narrow mode)
      TopBar.addCompactDivider();
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn   = cell.dataset.display;
        var name = cell.dataset.name || dn;
        TopBar.addCompactItem(name, dn, true, function() {
          setHeadsetVisible(dn, !headsetVisible[dn]);
          var allOn = Object.keys(headsetVisible).every(function(k) { return headsetVisible[k]; });
          if (allOn) { TopBar.setActiveFilter('all'); }
          else { TopBar.clearPresetFilters(); }
        });
      });
    }

    function setHeadsetVisible(dn, visible) {
      headsetVisible[dn] = visible;
      var cell = document.querySelector('#grid .cell[data-display="' + dn + '"]');
      if (cell) {
        cell.classList.toggle('hidden', !visible);
        if (!visible) cell.style.width = '';
      }
      var btn = document.querySelector('.headsets-filter-item[data-headset="' + dn + '"]');
      if (btn) btn.classList.toggle('checked', visible);
      TopBar.setCompactItemChecked(dn, visible);
      var allOn = Object.keys(headsetVisible).every(function(k) { return headsetVisible[k]; });
      var hfBtn = document.getElementById('headsets-filter-btn');
      if (hfBtn) hfBtn.classList.toggle('has-hidden', !allOn);
      applyAll();
    }

    // ------ Helpers ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

    // Parse semicolon-delimited CSV, strip surrounding quotes from every cell
    function parseCsv(text) {
      // Strip UTF-8 BOM that PowerShell 5 adds to Export-Csv -Encoding UTF8
      text = text.replace(/^\uFEFF/, '');
      var lines = text.trim().split(/\r?\n/);
      if (lines.length < 2) return [];
      var headers = lines[0].split(CSV_DELIMITER).map(function(h) {
        return h.replace(/^"|"$/g, '').trim();
      });
      return lines.slice(1).map(function(line) {
        var cols = line.split(CSV_DELIMITER).map(function(c) {
          return c.replace(/^"|"$/g, '').trim();
        });
        var obj = {};
        headers.forEach(function(h, i) { obj[h] = cols[i] !== undefined ? cols[i] : ''; });
        return obj;
      });
    }

    // Mirrors PowerShell Convert-Displayname: replace spaces with underscores
    function toDisplayName(name) {
      return name.replace(/ /g, '_');
    }

    function parseCsvText(text, delimiter) {
      text = text.replace(/^\uFEFF/, '');
      var lines = text.trim().split(/\r?\n/);
      if (lines.length < 2) return [];
      var headers = lines[0].split(delimiter).map(function(h) { return h.replace(/^"|"$/g, '').trim(); });
      return lines.slice(1).map(function(line) {
        var cols = line.split(delimiter).map(function(c) { return c.replace(/^"|"$/g, '').trim(); });
        var obj = {};
        headers.forEach(function(h, i) { obj[h] = cols[i] !== undefined ? cols[i] : ''; });
        return obj;
      });
    }

    function updateAutoRestartButtons() {
      document.querySelectorAll('.autorestart-btn').forEach(function(btn) {
        var dn = btn.dataset.cellHeadset;
        var on = autoRestartState[dn] || false;
        btn.classList.toggle('ar-on', on);
        btn.title = 'Auto-restart scrcpy: ' + (on ? 'ON' : 'OFF');
      });
    }

    function toggleAutoRestart(dn) {
      var newVal = !autoRestartState[dn];
      autoRestartState[dn] = newVal;
      updateAutoRestartButtons();
      fetch('/api/autorestart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: dn, value: newVal })
      })
      .then(function(r) { return r.json(); })
      .then(function(j) { if (!j.ok) { autoRestartState[dn] = !newVal; updateAutoRestartButtons(); } })
      .catch(function() { autoRestartState[dn] = !newVal; updateAutoRestartButtons(); });
    }

    function pollHeadsetsCsv() {
      fetch(HEADSETS_CSV_PATH + '?_=' + Date.now())
        .then(function(r) { if (!r.ok) throw new Error(r.status); return r.text(); })
        .then(function(text) {
          parseCsvText(text, ',').forEach(function(row) {
            var dn = toDisplayName(row['Name'] || '');
            if (!dn) return;
            autoRestartState[dn] = (row['scrcpy_AutoRestart'] || '').toLowerCase() === 'true';
          });
          updateAutoRestartButtons();
        })
        .catch(function() {});
    }

    document.getElementById('grid').addEventListener('click', function(e) {
      var arBtn = e.target.closest('.autorestart-btn');
      if (arBtn) { toggleAutoRestart(arBtn.dataset.cellHeadset); return; }
      var launchBtn = e.target.closest('.launch-app-btn');
      if (launchBtn) openLaunchModal(launchBtn.dataset.launchApp);
    });

    // ------ CSV polling ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    function pollCsv() {
      fetch(CSV_PATH + '?_=' + Date.now())
        .then(function(r) { if (!r.ok) throw new Error(r.status); return r.text(); })
        .then(function(text) {
          var rows = parseCsv(text);
          var newStatus = {};
          rows.forEach(function(row) {
            var dn = toDisplayName(row['Name'] || '');
            if (!dn) return;
            newStatus[dn] = {
              ping:       (row['Ping']  || '').toLowerCase() === 'true',
              scrcpy:     (row['SCRCPY'] || '').toLowerCase() === 'ok',
              adb:       (row['ADBWifi'] || '').toLowerCase() === 'true',
              runningApp: row['RunningApp'] || ''
            };
          });
          headsetStatus = newStatus;
          updateRunningApps();
          if (!initialFilterApplied) {
            initialFilterApplied = true;
            var anyActive = Object.keys(headsetVisible).some(function(dn) {
              return (headsetStatus[dn] || { scrcpy: false }).scrcpy;
            });
            if (anyActive) {
              Object.keys(headsetVisible).forEach(function(dn) {
                var stat = headsetStatus[dn] || { scrcpy: false };
                setHeadsetVisible(dn, stat.scrcpy);
              });
              TopBar.setActiveFilter('scrcpy');
            } else {
              Object.keys(headsetVisible).forEach(function(dn) { setHeadsetVisible(dn, true); });
              TopBar.setActiveFilter('all');
            }
          }
          applyOfflineState();
        })
        .catch(function() { /* keep last known state on network error */ });;
    }

    // ------ Running app badges ------------------------------------------------------------------------------------------------------------------------------------------------------------
    function updateRunningApps() {
      document.querySelectorAll('.running-app').forEach(function(el) {
        var dn  = el.dataset.runningApp;
        var pkg = (headsetStatus[dn] || {}).runningApp || '';
        if (!pkg) { el.classList.add('hidden'); return; }
        var displayName = appNameCache[pkg] || pkg;
        // Trim 'com.' prefix if no display name resolved
        if (displayName === pkg && pkg.indexOf('.') !== -1) {
          var parts = pkg.split('.');
          displayName = parts[parts.length - 1];
        }
        el.querySelector('.running-app-name').textContent = displayName;
        el.classList.remove('hidden');
      });
    }

    // ------ Video aspect ratio detection (removes black bands) ---------------------------------------------------------
    var _detectedRatios = {};
    function adaptCellAspectRatio(cell) {
      var dn = cell.dataset.display;
      if (_detectedRatios[dn]) return; // already adapted
      var frame = cell.querySelector('.video-frame');
      if (!frame) return;
      try {
        var doc = frame.contentWindow && frame.contentWindow.document;
        if (!doc) return;
        var video = doc.querySelector('video');
        if (video && video.videoWidth > 0 && video.videoHeight > 0) {
          var ratio = (video.videoWidth / video.videoHeight).toFixed(4);
          _detectedRatios[dn] = ratio;
          cell.style.aspectRatio = ratio;
          applyAll();
        }
      } catch(e) {}
    }

    // ------ Offline / no-stream state update ---------------------------------------------------------------------------------------------------------------
    function applyOfflineState() {
      var scaleNeeded = false;
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn        = cell.dataset.display;
        var stat      = headsetStatus[dn] || { ping: false, scrcpy: false };
        var wasStream = !cell.classList.contains('no-stream');
        var streaming = stat.scrcpy;

        cell.classList.toggle('offline',   !stat.ping);
        if (wasStream !== streaming) scaleNeeded = true;
        cell.classList.toggle('no-stream', !streaming);
        if (!streaming) cell.style.width = ''; // clear layout width for compact offline tile

        // Manage video-frame src: load only when streaming, clear otherwise
        var videoFrame  = cell.querySelector('.video-frame');
        var expectedSrc = dn + '[video].html';
        if (videoFrame) {
          var curSrc = videoFrame.getAttribute('src') || '';
          if (streaming && curSrc !== expectedSrc) {
            videoFrame.setAttribute('src', expectedSrc);
            var lastRatio = _detectedRatios[dn]; // keep as placeholder while re-detecting
            delete _detectedRatios[dn]; // reset so ratio is re-detected on new stream
            cell.style.aspectRatio = lastRatio ? String(lastRatio) : '16 / 9';
          } else if (!streaming && curSrc !== '') {
            videoFrame.setAttribute('src', ''); // stop loading stream
          }
        }

        var btn = document.querySelector('.headsets-filter-item[data-headset="' + dn + '"]');
        if (btn) btn.classList.toggle('offline', !stat.scrcpy);
        var compactItem = document.querySelector('[data-compact-headset="' + dn + '"]');
        if (compactItem) compactItem.classList.toggle('offline', !stat.scrcpy);
      });
      if (scaleNeeded) { applyAll(); }
    }

    // ------ Scale status overlays ------------------------------------------------------------------------------------------------------------------------------------------------
    // Detect natural height of monitoring iframes for accurate no-stream scaling
    function detectFrameHeight(fr, cell) {
      var dn = cell ? cell.dataset.display : null;
      if (!dn) return;
      try {
        var doc = fr.contentDocument || (fr.contentWindow && fr.contentWindow.document);
        if (!doc || !doc.documentElement) return;
        var h = doc.documentElement.scrollHeight;
        if (h > 10) { naturalHeights[dn] = h; applyAll(); }
      } catch(e) {}
    }

    var MIN_OVERLAY_W = 200;
    function applyScale() {
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn = cell.dataset.display;
        var isNoStream = cell.classList.contains('no-stream');
        var cellW = cell.offsetWidth;
        var cellH = cell.offsetHeight;
        var wrapperW, wrapperH, scale;
        if (isNoStream) {
          var naturalH = naturalHeights[dn] || NATURAL_H;
          scale    = cellW / NATURAL_W;
          wrapperW = cellW;
          wrapperH = Math.round(naturalH * scale);
          cell.style.height = wrapperH + 'px';
        } else {
          cell.style.height = '';
          var maxByW = Math.floor(cellW / 3);
          var naturalH = naturalHeights[dn] || NATURAL_H;
          var maxByH = cellH > 0 ? Math.floor(cellH / 3 * NATURAL_W / naturalH) : maxByW;
          var targetW = Math.min(maxByW, maxByH);
          wrapperW = Math.max(targetW, MIN_OVERLAY_W);
          wrapperH = Math.round(wrapperW * naturalH / NATURAL_W);
          scale    = wrapperW / NATURAL_W;
        }
        var wrapper = cell.querySelector('.status-wrapper');
        if (wrapper) { wrapper.style.width = wrapperW + 'px'; wrapper.style.height = wrapperH + 'px'; }
        cell.querySelectorAll('.status-frame').forEach(function(fr) {
          fr.style.width  = NATURAL_W + 'px';
          fr.style.height = (naturalHeights[dn] || NATURAL_H) + 'px';
          fr.style.transform = 'scale(' + scale + ')';
        });
      });
    }

    // ------ Viewport-fit layout: compute optimal columns so videos fit in the window ---
    function applyLayout() {
      var topbar = document.querySelector('.topbar');
      var topbarH = topbar ? (topbar.offsetHeight + 1) : 47;
      var gap = 6;
      var padding = gap;
      var availW = window.innerWidth;
      var availH = window.innerHeight - topbarH;
      var innerW = availW - padding * 2;
      var innerH = availH - padding * 2;

      var streamCells = Array.from(document.querySelectorAll('#grid .cell:not(.hidden):not(.no-stream)'));
      var N = streamCells.length;
      if (N === 0) return;

      // Reserve vertical space for offline tiles row (below streaming cells via CSS order)
      var noStreamReserved = 0;
      (function() {
        var noStreamCells = Array.from(document.querySelectorAll('#grid .cell:not(.hidden).no-stream'));
        if (noStreamCells.length === 0) return;
        var nsW = Math.min(NO_STREAM_W, innerW);
        var maxNaturalH = NATURAL_H;
        noStreamCells.forEach(function(c) {
          var dn = c.dataset.display;
          var h = naturalHeights[dn] || NATURAL_H;
          if (h > maxNaturalH) maxNaturalH = h;
        });
        var nsH = Math.round(maxNaturalH * nsW / NATURAL_W);
        var tilesPerRow = Math.max(1, Math.floor((innerW + gap) / (nsW + gap)));
        noStreamReserved = Math.ceil(noStreamCells.length / tilesPerRow) * (nsH + gap);
      })();
      var effectiveInnerH = Math.max(innerH - noStreamReserved, 80);
      // Use the most constraining (smallest) detected ratio so every cell fits vertically.
      var worstRatio = 16 / 9;
      streamCells.forEach(function(cell) {
        var dn = cell.dataset.display;
        var detected = parseFloat(_detectedRatios[dn]);
        if (detected > 0 && detected < worstRatio) worstRatio = detected;
      });

      var bestArea = 0;
      var bestCellW = Math.min(innerW, effectiveInnerH * worstRatio);

      for (var c = 1; c <= N; c++) {
        var r = Math.ceil(N / c);
        var cellW = (innerW - gap * (c - 1)) / c;
        var cellH = cellW / worstRatio;
        if (cellH * r + gap * (r - 1) > effectiveInnerH) {
          // Height-constrained: scale down to fit
          cellH = (effectiveInnerH - gap * (r - 1)) / r;
          cellW = cellH * worstRatio;
        }
        var area = cellW * cellH;
        if (area > bestArea) {
          bestArea = area;
          bestCellW = cellW;
        }
      }

      var w = Math.floor(bestCellW);
      streamCells.forEach(function(cell) { cell.style.width = w + 'px'; });
    }

    // ------ Status overlay toggle ------------------------------------------------------------------------------------------------------------------------------------------------
    var statusVisible = true;
    var statusToggleBtn = document.getElementById('status-toggle');
    statusToggleBtn.style.color = 'var(--filter-active-bg)';
    statusToggleBtn.addEventListener('click', function() {
      statusVisible = !statusVisible;
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        cell.classList.toggle('status-hidden', !statusVisible);
      });
      this.style.color = statusVisible ? 'var(--filter-active-bg)' : '';
    });


    // ---- Timer overlay management ----
    var timerIntervals = {};  // keyed by headset numeric id
    var timerGlobalVisible = false;

    var timerToggleBtn = document.getElementById('timer-toggle');
    timerToggleBtn.addEventListener('click', function() {
      timerGlobalVisible = !timerGlobalVisible;
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        cell.classList.toggle('timer-hidden', !timerGlobalVisible);
      });
      this.style.color = timerGlobalVisible ? 'var(--filter-active-bg)' : '';
      document.querySelectorAll('.timer-overlay[data-timer-cell]').forEach(function(overlay) {
        var tid = overlay.dataset.timerCell;
        if (timerGlobalVisible) {
          startCellTimerPoll(tid);
          syncCellTimerBtn(tid);
          var btn = document.querySelector('.cell-timer-btn[data-timer-cell="' + tid + '"]');
          if (btn) btn.style.display = 'flex';
        } else {
          stopCellTimerPoll(tid);
          var btn = document.querySelector('.cell-timer-btn[data-timer-cell="' + tid + '"]');
          if (btn) btn.style.display = 'none';
        }
      });
    });

    function syncCellTimerBtn(tid) {
      fetch('/api/timer?id=' + tid + '&action=status')
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(j) {
          if (!j) return;
          var btn = document.querySelector('.cell-timer-btn[data-timer-cell="' + tid + '"]');
          if (!btn) return;
          btn.classList.remove('running', 'paused');
          if (j.active) { btn.classList.add('running'); }
          else if (j.paused) { btn.classList.add('paused'); }
        }).catch(function() {});
    }

    function startCellTimerPoll(tid) {
      stopCellTimerPoll(tid);
      function poll() {
        fetch('/api/timer?id=' + tid + '&action=status&_=' + Date.now())
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(j) {
            if (!j) return;
            var overlay = document.querySelector('.timer-overlay[data-timer-cell="' + tid + '"]');
            var btn = document.querySelector('.cell-timer-btn[data-timer-cell="' + tid + '"]');
            var v = (j.value || '').trim();
            if (overlay) {
              if (v) { overlay.textContent = v; overlay.classList.add('visible'); }
              else   { overlay.classList.remove('visible'); }
            }
            if (btn) {
              btn.classList.remove('running', 'paused');
              if (j.active) { btn.classList.add('running'); }
              else if (j.paused) { btn.classList.add('paused'); }
            }
          }).catch(function() {});
      }
      poll();
      timerIntervals[tid] = setInterval(poll, 1000);
    }

    function stopCellTimerPoll(tid) {
      if (timerIntervals[tid]) { clearInterval(timerIntervals[tid]); delete timerIntervals[tid]; }
    }

    // ---- Timer cell button click/long-press (delegated) ----
    (function() {
      var _lpTimer = null;
      var _longPressed = false;
      var _lpBtn = null;
      var _lastTouchEnd = 0;
      var _lastToggleTime = {};

      function doResetBtn(btn) {
        var tid = btn.dataset.timerCell;
        _lastToggleTime[tid] = 0;
        fetch('/api/timer?id=' + tid + '&action=reset')
          .then(function(r) { return r.json(); })
          .then(function(j) {
            if (j.ok) { btn.classList.remove('running', 'paused'); }
          }).catch(function() {});
      }

      // pause/resume: if the previous toggle on this button was within 800ms, treat as double-tap -> reset
      function doTimerAction(btn) {
        var tid = btn.dataset.timerCell;
        var now = Date.now();
        if (btn.classList.contains('running')) {
          if (now - (_lastToggleTime[tid] || 0) < 800) { doResetBtn(btn); return; }
          _lastToggleTime[tid] = now;
          fetch('/api/timer?id=' + tid + '&action=pause')
            .then(function(r) { return r.json(); })
            .then(function(j) {
              if (j.ok) { btn.classList.remove('running'); btn.classList.add('paused'); }
            }).catch(function() {});
        } else if (btn.classList.contains('paused')) {
          if (now - (_lastToggleTime[tid] || 0) < 800) { doResetBtn(btn); return; }
          _lastToggleTime[tid] = now;
          fetch('/api/timer?id=' + tid + '&action=resume')
            .then(function(r) { return r.json(); })
            .then(function(j) {
              if (j.ok) { btn.classList.remove('paused'); btn.classList.add('running'); }
            }).catch(function() {});
        } else {
          _lastToggleTime[tid] = 0;
          fetch('/api/timer?id=' + tid + '&action=start')
            .then(function(r) { return r.json(); })
            .then(function(j) {
              if (j.ok) { btn.classList.add('running'); }
            }).catch(function() {});
        }
      }

      function handleTap(btn) { doTimerAction(btn); }

      function startLongPress(btn) {
        _lpBtn = btn;
        _longPressed = false;
        _lpTimer = setTimeout(function() {
          _lpTimer = null;
          _longPressed = true;
          _lastTapTime = 0; _lastTapBtn = null;
          doResetBtn(btn);
        }, 800);
      }
      function cancelLongPress() {
        if (_lpTimer) { clearTimeout(_lpTimer); _lpTimer = null; }
      }

      // Mouse: long press + single/double-click
      document.getElementById('grid').addEventListener('mousedown', function(e) {
        var btn = e.target.closest('.cell-timer-btn[data-timer-cell]');
        if (btn) startLongPress(btn);
      });
      document.getElementById('grid').addEventListener('mouseup',    cancelLongPress);
      document.getElementById('grid').addEventListener('mouseleave', cancelLongPress);
      document.getElementById('grid').addEventListener('click', function(e) {
        if (Date.now() - _lastTouchEnd < 500) return; // suppress synthetic click from touch
        var btn = e.target.closest('.cell-timer-btn[data-timer-cell]');
        if (!btn) return;
        if (_longPressed) { _longPressed = false; return; }
        handleTap(btn);
      });

      // Touch: long press via touchstart; single/double-tap via touchend
      document.getElementById('grid').addEventListener('touchstart', function(e) {
        var btn = e.target.closest('.cell-timer-btn[data-timer-cell]');
        if (btn) { e.stopPropagation(); startLongPress(btn); }
      }, { passive: true });
      document.getElementById('grid').addEventListener('touchend', function(e) {
        var btn = e.target.closest('.cell-timer-btn[data-timer-cell]');
        if (!btn) return;
        e.preventDefault();
        _lastTouchEnd = Date.now();
        cancelLongPress();
        if (!_longPressed) {
          handleTap(btn);
        }
        _longPressed = false;
      }, { passive: false });
      document.getElementById('grid').addEventListener('touchcancel', cancelLongPress);
      document.getElementById('grid').addEventListener('contextmenu', function(e) {
        if (e.target.closest('.cell-timer-btn[data-timer-cell]')) e.preventDefault();
      });
    })();

    // Run scale then layout then scale again so no-stream heights are known before streaming layout
    var _applyingAll = false;
    function applyAll() {
      if (_applyingAll) return;
      _applyingAll = true;
      try { applyScale(); applyLayout(); applyScale(); }
      finally { _applyingAll = false; }
    }

    // ------ Boot ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    TopBar.initCompact();
    TopBar.initManageDevicesBtn();
    buildHeadsetToggles();

    // Override compact detection: topbar-filters is flex:0 so scrollWidth check doesn't work.
    // Instead check if the overlay-toggles right edge overlaps the topbar-right left edge.
    document.addEventListener('DOMContentLoaded', function() {
      var topbar        = document.querySelector('.topbar');
      var overlayEl     = document.getElementById('overlay-toggles');
      var rightSection  = document.querySelector('.topbar-right');
      if (!topbar || !overlayEl || !rightSection) return;
      var checkCompact = function() {
        topbar.classList.remove('compact');
        var r1 = overlayEl.getBoundingClientRect().right;
        var r2 = rightSection.getBoundingClientRect().left;
        topbar.classList.toggle('compact', r1 > r2 - 4);
      };
      new ResizeObserver(checkCompact).observe(topbar);
    });


    // Attach height-detection listeners to all status-frames
    document.querySelectorAll('#grid .cell').forEach(function(cell) {
      var fr = cell.querySelector('.status-frame');
      if (!fr) return;
      fr.addEventListener('load', function() { detectFrameHeight(fr, cell); });
    });
    var ro = new ResizeObserver(function() { applyAll(); });
    ro.observe(document.getElementById('grid'));
    window.addEventListener('resize', function() { applyAll(); });

    document.addEventListener('DOMContentLoaded', function() {
      applyAll();
      pollCsv();
      setInterval(pollCsv, REFRESH_MS);
      pollHeadsetsCsv();
      setInterval(pollHeadsetsCsv, 10000);
      // Check monitoring HTML existence and pre-load favorite app names
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn = cell.dataset.display;
        if (!dn) return;
        fetch('/api/favoriteapps?name=' + encodeURIComponent(dn))
          .then(function(r) { return r.json(); })
          .then(function(favs) { favs.forEach(function(a) { if (a.package && a.displayName) appNameCache[a.package] = a.displayName; }); })
          .catch(function() {});
      });
      // Periodically detect actual video dimensions to eliminate black bands
      setInterval(function() {
        document.querySelectorAll('#grid .cell:not(.no-stream)').forEach(adaptCellAspectRatio);
      }, 1500);
    });
  </script>
  <script src="assets/app_launcher.js"></script>
  <script>appLauncher.setStatusResolver(function(dn) { return !!(headsetStatus[dn] && headsetStatus[dn].adb); });</script>
</body>
</html>
