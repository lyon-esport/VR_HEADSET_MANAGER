<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VR Headsets - Video Monitor</title>
  <link rel="stylesheet" href="assets/topbar.css">
  <script src="assets/topbar.js"></script>
  <style>
    /* ─── Configuration ─────────────────────────────────────────────────────── */
    :root {
      --min-video-w:        640px;  /* minimum width per video cell */
      --grid-gap:           6px;
      --bg:                 #111;
      --dot-all:            #444;
      --dot-ping:           #22c55e;
      --dot-stream:         #3b82f6;
      --muted:              #333;
    }
    /* ─────────────────────────────────────────────────────────────────────── */

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background: var(--bg);
      min-height: 100vh;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      overflow-x: hidden;
    }

    .dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .dot-all    { background: var(--dot-all); }
    .dot-ping   { background: var(--dot-ping); }
    .dot-stream { background: var(--dot-stream); }
    .badge {
      font-size: 10px;
      font-weight: 700;
      opacity: 0.65;
    }

    /* Right section */
    .topbar-right {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      margin-left: auto;
    }
    #last-update {
      padding: 0 14px;
      color: var(--muted);
      font-size: 11px;
      white-space: nowrap;
    }

    /* Video grid - flexbox so streaming and offline tiles can have different sizes */
    .grid {
      display: flex;
      flex-wrap: wrap;
      gap: var(--grid-gap);
      padding: var(--grid-gap);
      align-content: flex-start;
      align-items: flex-start;
    }

    /* Cell - streaming (default) - width set dynamically by applyLayout() */
    .cell {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #000;
      border-radius: 3px;
      container-type: size;
      flex: 0 0 auto;
      min-width: 0;
      max-width: 100%;
    }
    .cell.hidden { display: none; }

    /* Compact offline tile - no video stream, monitoring frame fills cell */
    .cell.no-stream {
      flex: 0 0 auto;
      width: min(360px, 100%);
    }
    .cell.no-stream .video-frame    { display: none; }
    .cell.no-stream .status-wrapper { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 3px; }
    .cell.no-stream .cell-actions   { opacity: 1; }
    .cell.no-stream .running-app    { display: none !important; }

    /* Full-cell video iframe */
    .video-frame {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      border: none;
    }

    /* Status PiP wrapper - top-left, 1/3 of cell width, 16:9 */
    .status-wrapper {
      position: absolute;
      top: 0; left: 0;
      width: 33.333%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      z-index: 10;
      border-radius: 0 0 3px 0;
    }
    /* Rendered at NATURAL_W x NATURAL_H, scaled by JS */
    .status-frame {
      position: absolute;
      top: 0; left: 0;
      border: none;
      pointer-events: none;
      transform-origin: top left;
    }

    /* Hide status overlays when toggle is off */
    .status-hidden .status-wrapper { display: none; }
    .status-hidden .running-app    { display: none; }

    /* Running app badge - top center */
    .running-app {
      position: absolute;
      top: 1.2%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 15;
      max-width: 60%;
      background: rgba(0,0,0,0.58);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 20px;
      padding: 0.4% 1.4%;
      display: flex;
      align-items: center;
      pointer-events: none;
      white-space: nowrap;
      overflow: hidden;
    }
    .running-app-name {
      font-size: 1.8cqw;
      font-weight: 700;
      color: rgba(255,255,255,0.90);
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .running-app:empty { display: none; }
    .running-app.hidden { display: none; }

    /* Cell action buttons - top-right corner */
    .cell-actions {
      position: absolute;
      top: 8px; right: 8px;
      z-index: 30;
      display: flex;
      flex-direction: column;
      gap: 4px;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .cell:hover .cell-actions { opacity: 1; }
    .cell-action-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px; height: 30px;
      border-radius: 6px;
      background: rgba(0,0,0,0.55);
      border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.70);
      cursor: pointer;
      text-decoration: none;
      font-family: inherit;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .cell-action-btn:hover { background: rgba(59,130,246,0.75); color: #fff; border-color: rgba(59,130,246,0.6); }
    .cell-action-btn.ar-on { background: rgba(34,197,94,0.28); color: #22c55e; border-color: rgba(34,197,94,0.5); }
    .cell-action-btn.ar-on:hover { background: rgba(34,197,94,0.50); }

    /* Launch app modal */
    .launch-modal {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(0,0,0,0.72);
      display: flex; align-items: flex-start; justify-content: center;
    }
    .launch-modal-box {
      background: #1a1a1a; border: 1px solid #333;
      border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
      width: 100%; max-width: 520px;
      display: flex; flex-direction: column;
      box-shadow: 0 8px 32px rgba(0,0,0,0.7);
      max-height: 80vh; overflow: hidden;
    }
    .lm-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 18px 12px; border-bottom: 1px solid #252525; flex-shrink: 0;
    }
    .lm-title-wrap { display: flex; flex-direction: column; gap: 2px; }
    .lm-headset-label { font-size: 10px; font-weight: 700; color: #444; text-transform: uppercase; letter-spacing: 0.06em; }
    .lm-title { font-size: 14px; font-weight: 700; color: #e0e0e0; }
    .lm-close {
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; padding: 0;
      background: transparent; border: 1px solid transparent; border-radius: 5px;
      color: #555; cursor: pointer; transition: color 0.12s, border-color 0.12s;
    }
    .lm-close:hover { color: #aaa; border-color: #333; }
    .lm-list { overflow-y: auto; flex: 1; padding: 6px 0; }
    .lm-section-label { padding: 8px 18px 4px; font-size: 10px; font-weight: 700; color: #444; text-transform: uppercase; letter-spacing: 0.06em; }
    .lm-app-row { display: flex; align-items: center; gap: 10px; padding: 7px 18px; transition: background 0.1s; }
    .lm-app-row:hover { background: #202020; }
    .lm-app-name { flex: 1; font-size: 13px; color: #ccc; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lm-app-row.is-meta .lm-app-name { color: #67e8f9; font-weight: 600; }
    .lm-star-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; padding: 0; flex-shrink: 0;
      background: transparent; border: none; border-radius: 4px;
      cursor: pointer; color: #3a3a3a; transition: color 0.12s;
    }
    .lm-star-btn.active { color: #facc15; }
    .lm-star-btn:hover { color: #facc15; }
    .lm-app-row.is-meta .lm-star-btn { visibility: hidden; }
    .lm-launch-btn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 3px 10px; border-radius: 5px;
      border: 1px solid #2a4a7a; background: rgba(59,130,246,0.1);
      color: #3b82f6; font-size: 11px; font-weight: 700;
      cursor: pointer; font-family: inherit; flex-shrink: 0;
      transition: background 0.12s, border-color 0.12s;
    }
    .lm-launch-btn:hover { background: rgba(59,130,246,0.22); border-color: #3b82f6; }
    .lm-footer {
      border-top: 1px solid #252525; padding: 10px 18px;
      flex-shrink: 0; display: flex; flex-direction: column; gap: 8px;
    }
    .lm-show-all-btn {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 7px; border-radius: 6px;
      border: 1px solid #333; background: #161616;
      color: #666; font-size: 12px; font-weight: 600;
      cursor: pointer; font-family: inherit; width: 100%;
      transition: color 0.12s, border-color 0.12s;
    }
    .lm-show-all-btn:hover { color: #aaa; border-color: #444; }
    .lm-status { font-size: 11px; color: #444; text-align: center; min-height: 16px; }
    .lm-status.ok  { color: #22c55e; }
    .lm-status.err { color: #ef4444; }

    /* Offline dimming overlay */
    .offline-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.60);
      z-index: 20;
      display: none;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.35);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.08em;
      pointer-events: none;
    }
    .cell.offline .offline-overlay { display: flex; }
    /* In no-stream mode the OFFLINE label sits behind the monitoring frame */
    .cell.no-stream .offline-overlay { z-index: 5; }

    /* ── Light mode ─────────────────────────────────────────────────────────── */
    [data-theme="light"] {
      --bg:    #eaeaea;
      --muted: #999;
    }
    [data-theme="light"] .cell                           { background: #c8c8c8; }
    [data-theme="light"] .running-app                    { background: rgba(255,255,255,0.72); border-color: rgba(0,0,0,0.10); }
    [data-theme="light"] .running-app-name               { color: rgba(0,0,0,0.85); }
    [data-theme="light"] .cell-action-btn                { background: rgba(255,255,255,0.65); color: rgba(0,0,0,0.55); border-color: rgba(0,0,0,0.12); }
    [data-theme="light"] .cell-action-btn:hover          { background: rgba(59,130,246,0.75); color: #fff; border-color: rgba(59,130,246,0.6); }
    [data-theme="light"] .cell-action-btn.ar-on          { background: rgba(34,197,94,0.20); color: #16a34a; border-color: rgba(34,197,94,0.4); }
    [data-theme="light"] .launch-modal                   { background: rgba(0,0,0,0.38); }
    [data-theme="light"] .launch-modal-box               { background: #fff; border-color: #e5e5e5; box-shadow: 0 8px 32px rgba(0,0,0,0.18); }
    [data-theme="light"] .lm-header                      { border-color: #efefef; }
    [data-theme="light"] .lm-headset-label               { color: #bbb; }
    [data-theme="light"] .lm-title                       { color: #111; }
    [data-theme="light"] .lm-close                       { color: #bbb; }
    [data-theme="light"] .lm-close:hover                 { color: #555; border-color: #ddd; }
    [data-theme="light"] .lm-section-label               { color: #bbb; }
    [data-theme="light"] .lm-app-row:hover               { background: #f8f8f8; }
    [data-theme="light"] .lm-app-name                    { color: #333; }
    [data-theme="light"] .lm-app-row.is-meta .lm-app-name { color: #0e7490; }
    [data-theme="light"] .lm-star-btn                    { color: #ccc; }
    [data-theme="light"] .lm-footer                      { border-color: #efefef; }
    [data-theme="light"] .lm-show-all-btn                { background: #f5f5f5; border-color: #ddd; color: #666; }
    [data-theme="light"] .lm-show-all-btn:hover          { color: #222; border-color: #bbb; }
    [data-theme="light"] .lm-status                      { color: #bbb; }
  </style>
</head>
<body>

  <header class="topbar">

    <!-- Left: brand -->
    <script>document.write(TopBar.brandHTML)</script>

    <div class="v-sep"></div>

    <!-- Compact headset picker (shown when topbar overflows) -->
    <script>document.write(TopBar.compactDropdownHTML)</script>

    <!-- Center: per-headset visibility toggles (buttons injected by JS) -->
    <div class="topbar-filters" id="headset-toggles">
      <span class="filter-label">Show:</span>
      <script>document.write(TopBar.filtersHTML)</script>
    </div>

    <!-- Right: status toggle + shared Config dropdown -->
    <div class="topbar-right">
      <div class="v-sep"></div>
      <button class="actions-btn" id="status-toggle" title="Toggle status overlay">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        Status
      </button>
      <script>document.write(TopBar.manageDevicesBtnHTML)</script>
      <script>document.write(TopBar.configMenuHTML)</script>
    </div>

  </header>

  <div class="grid" id="grid">
<% foreach ($headset in $headsets) { %>
    <div class="cell" data-name="<%= $headset.name %>" data-display="<%= $headset.displayName %>">
      <iframe class="video-frame"   src="<%= $headset.displayName %>[video].html"      allow="autoplay" scrolling="no"></iframe>
      <div class="status-wrapper">
        <iframe class="status-frame" src="<%= $headset.displayName %>[monitoring].html" scrolling="no"></iframe>
      </div>
      <div class="cell-actions">
        <a class="cell-action-btn" href="<%= $headset.displayName %>[video].html" target="_blank" title="Open fullscreen" aria-label="Open fullscreen">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/>
            <line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
          </svg>
        </a>
        <button class="cell-action-btn autorestart-btn" data-cell-headset="<%= $headset.displayName %>" title="Auto-restart scrcpy: OFF" aria-label="Toggle auto-restart">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.55"/>
          </svg>
        </button>
        <a class="cell-action-btn" href="headset_settings.html?headset=<%= $headset.displayName %>" title="Headset settings" aria-label="Headset settings">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
            <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
          </svg>
        </a>
        <button class="cell-action-btn launch-app-btn" data-launch-app="<%= $headset.displayName %>" title="Launch app" aria-label="Launch app">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </button>
      </div>
      <div class="running-app hidden" data-running-app="<%= $headset.displayName %>">
        <span class="running-app-name"></span>
      </div>
      <div class="offline-overlay">OFFLINE</div>
    </div>
<% } %>
  </div>

  <!-- Launch app modal -->
  <div class="launch-modal" id="launch-modal" style="display:none">
    <div class="launch-modal-box">
      <div class="lm-header">
        <div class="lm-title-wrap">
          <span class="lm-headset-label" id="lm-headset-label"></span>
          <span class="lm-title">Launch App</span>
        </div>
        <button class="lm-close" id="lm-close" title="Close">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="lm-list" id="lm-list"></div>
      <div class="lm-footer">
        <button class="lm-show-all-btn" id="lm-show-all-btn">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
          Show all installed apps
        </button>
        <div class="lm-status" id="lm-status"></div>
      </div>
    </div>
  </div>

  <script>
    // ── Configuration ────────────────────────────────────────────────────────
    var CSV_PATH      = '../data/known_headsets_infos.csv';
    var CSV_DELIMITER = ';';
    var REFRESH_MS    = 5000;   // CSV poll interval in ms
    var NATURAL_W     = 480;    // natural render width of the status iframe
    var NATURAL_H     = 270;    // must keep 16:9 ratio with NATURAL_W
    // ─────────────────────────────────────────────────────────────────────────

    var HEADSETS_CSV_PATH = '../data/known_headsets.csv';
    var headsetStatus = {};
    var autoRestartState = {};
    var initialFilterApplied = false;

    // ── Per-headset visibility toggles ──────────────────────────────────────────
    var headsetVisible = {};

    TopBar.initFilters(function(f) {
      Object.keys(headsetVisible).forEach(function(dn) {
        var stat = headsetStatus[dn] || { ping: false, scrcpy: false };
        var show = true;
        if (f === 'online')  show = stat.ping;
        if (f === 'scrcpy')  show = stat.scrcpy;
        if (f === 'offline') show = !stat.ping;
        setHeadsetVisible(dn, show);
      });
    });

    function buildHeadsetToggles() {
      var container = document.getElementById('headset-toggles');

      // Shared preset buttons already injected; add separator then per-headset buttons
      var sep = document.createElement('span');
      sep.className = 'v-sep';
      sep.style.cssText = 'margin: 8px 6px; height: auto; align-self: stretch;';
      container.appendChild(sep);

      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn   = cell.dataset.display;
        var name = cell.dataset.name || dn;
        headsetVisible[dn] = true;

        var btn = document.createElement('button');
        btn.className = 'filter-btn';
        btn.dataset.headset = dn;
        btn.textContent = name;
        btn.addEventListener('click', function() {
          setHeadsetVisible(dn, !headsetVisible[dn]);
          var allOn  = Object.keys(headsetVisible).every(function(k) { return headsetVisible[k]; });
          if (allOn)  { TopBar.setActiveFilter('all'); }
          else { TopBar.clearPresetFilters(); }
        });
        container.appendChild(btn);
      });

      // Add per-headset items to compact dropdown
      TopBar.addCompactDivider();
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn   = cell.dataset.display;
        var name = cell.dataset.name || dn;
        TopBar.addCompactItem(name, dn, true, function() {
          setHeadsetVisible(dn, !headsetVisible[dn]);
          var allOn = Object.keys(headsetVisible).every(function(k) { return headsetVisible[k]; });
          if (allOn) { TopBar.setActiveFilter('all'); }
          else { TopBar.clearPresetFilters(); }
        });
      });
    }

    function setHeadsetVisible(dn, visible) {
      headsetVisible[dn] = visible;
      var cell = document.querySelector('#grid .cell[data-display="' + dn + '"]');
      if (cell) {
        cell.classList.toggle('hidden', !visible);
        if (!visible) cell.style.width = '';
      }
      var btn = document.querySelector('[data-headset="' + dn + '"]');
      if (btn) btn.classList.toggle('active', visible);
      TopBar.setCompactItemChecked(dn, visible);
      applyLayout();
      applyScale();
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Parse semicolon-delimited CSV, strip surrounding quotes from every cell
    function parseCsv(text) {
      // Strip UTF-8 BOM that PowerShell 5 adds to Export-Csv -Encoding UTF8
      text = text.replace(/^\uFEFF/, '');
      var lines = text.trim().split(/\r?\n/);
      if (lines.length < 2) return [];
      var headers = lines[0].split(CSV_DELIMITER).map(function(h) {
        return h.replace(/^"|"$/g, '').trim();
      });
      return lines.slice(1).map(function(line) {
        var cols = line.split(CSV_DELIMITER).map(function(c) {
          return c.replace(/^"|"$/g, '').trim();
        });
        var obj = {};
        headers.forEach(function(h, i) { obj[h] = cols[i] !== undefined ? cols[i] : ''; });
        return obj;
      });
    }

    // Mirrors PowerShell Convert-Displayname: replace spaces with underscores
    function toDisplayName(name) {
      return name.replace(/ /g, '_');
    }

    function parseCsvText(text, delimiter) {
      text = text.replace(/^\uFEFF/, '');
      var lines = text.trim().split(/\r?\n/);
      if (lines.length < 2) return [];
      var headers = lines[0].split(delimiter).map(function(h) { return h.replace(/^"|"$/g, '').trim(); });
      return lines.slice(1).map(function(line) {
        var cols = line.split(delimiter).map(function(c) { return c.replace(/^"|"$/g, '').trim(); });
        var obj = {};
        headers.forEach(function(h, i) { obj[h] = cols[i] !== undefined ? cols[i] : ''; });
        return obj;
      });
    }

    function updateAutoRestartButtons() {
      document.querySelectorAll('.autorestart-btn').forEach(function(btn) {
        var dn = btn.dataset.cellHeadset;
        var on = autoRestartState[dn] || false;
        btn.classList.toggle('ar-on', on);
        btn.title = 'Auto-restart scrcpy: ' + (on ? 'ON' : 'OFF');
      });
    }

    function toggleAutoRestart(dn) {
      var newVal = !autoRestartState[dn];
      autoRestartState[dn] = newVal;
      updateAutoRestartButtons();
      fetch('/api/autorestart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: dn, value: newVal })
      })
      .then(function(r) { return r.json(); })
      .then(function(j) { if (!j.ok) { autoRestartState[dn] = !newVal; updateAutoRestartButtons(); } })
      .catch(function() { autoRestartState[dn] = !newVal; updateAutoRestartButtons(); });
    }

    function pollHeadsetsCsv() {
      fetch(HEADSETS_CSV_PATH + '?_=' + Date.now())
        .then(function(r) { if (!r.ok) throw new Error(r.status); return r.text(); })
        .then(function(text) {
          parseCsvText(text, ',').forEach(function(row) {
            var dn = toDisplayName(row['Name'] || '');
            if (!dn) return;
            autoRestartState[dn] = (row['scrcpy_AutoRestart'] || '').toLowerCase() === 'true';
          });
          updateAutoRestartButtons();
        })
        .catch(function() {});
    }

    document.getElementById('grid').addEventListener('click', function(e) {
      var arBtn = e.target.closest('.autorestart-btn');
      if (arBtn) { toggleAutoRestart(arBtn.dataset.cellHeadset); return; }
      var launchBtn = e.target.closest('.launch-app-btn');
      if (launchBtn) openLaunchModal(launchBtn.dataset.launchApp);
    });

    // ── Launch app modal ─────────────────────────────────────────────────────
    var _launchDn         = null;
    var _allAppsLoaded    = false;
    var _allApps          = [];
    var _favoritePackages = {};
    var appNameCache      = {};

    function openLaunchModal(dn) {
      _launchDn      = dn;
      _allAppsLoaded = false;
      _allApps       = [];
      document.getElementById('lm-headset-label').textContent = dn.replace(/_/g,' ');
      document.getElementById('lm-status').textContent = '';
      document.getElementById('lm-status').className   = 'lm-status';
      var showAllBtn = document.getElementById('lm-show-all-btn');
      showAllBtn.disabled = false;
      showAllBtn.style.display = '';
      showAllBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg> Show all installed apps';
      document.getElementById('launch-modal').style.display = 'flex';
      renderLaunchList([]);
      fetch('/api/favoriteapps?name=' + encodeURIComponent(_launchDn))
        .then(function(r) { return r.json(); })
        .then(function(favs) {
          _favoritePackages = {};
          favs.forEach(function(a) { _favoritePackages[a.package] = true; appNameCache[a.package] = a.displayName; });
          renderLaunchList(favs, true);
        })
        .catch(function() {
          document.getElementById('lm-status').textContent = 'Could not load favorites.';
          document.getElementById('lm-status').className   = 'lm-status err';
        });
    }

    function closeLaunchModal() {
      document.getElementById('launch-modal').style.display = 'none';
      _launchDn = null;
    }

    function renderLaunchList(apps, isFavView) {
      var list = document.getElementById('lm-list');
      list.innerHTML = '';
      var metaHomePkg = 'com.oculus.vrshell';
      var hasMetaHome = apps.some(function(a) { return a.package === metaHomePkg; });
      var displayApps = apps.slice();
      if (!hasMetaHome && (isFavView || _allAppsLoaded)) {
        displayApps.unshift({ package: metaHomePkg, displayName: 'Meta Home', favorite: true });
      }
      if (displayApps.length === 0) {
        list.innerHTML = '<div class="lm-section-label" style="padding-top:14px;text-align:center">Loading...</div>';
        return;
      }
      if (isFavView && !_allAppsLoaded) {
        var s = document.createElement('div'); s.className = 'lm-section-label'; s.textContent = 'Favorites'; list.appendChild(s);
      }
      displayApps.forEach(function(app) { renderAppRow(app, list); });
    }

    function renderAppRow(app, list) {
      var metaHomePkg = 'com.oculus.vrshell';
      var isMeta = app.package === metaHomePkg;
      var isFav  = isMeta || !!_favoritePackages[app.package];
      var row = document.createElement('div');
      row.className = 'lm-app-row' + (isMeta ? ' is-meta' : '');

      var starBtn = document.createElement('button');
      starBtn.className = 'lm-star-btn' + (isFav ? ' active' : '');
      starBtn.title = isFav ? 'Remove from favorites' : 'Add to favorites';
      starBtn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="' + (isFav ? 'currentColor' : 'none') + '" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
      (function(a, sb) {
        sb.addEventListener('click', function(e) {
          e.stopPropagation();
          if (isMeta) return;
          var newFav = !_favoritePackages[a.package];
          if (newFav) { _favoritePackages[a.package] = true; } else { delete _favoritePackages[a.package]; }
          sb.className = 'lm-star-btn' + (newFav ? ' active' : '');
          sb.title = newFav ? 'Remove from favorites' : 'Add to favorites';
          sb.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="' + (newFav ? 'currentColor' : 'none') + '" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
          fetch('/api/togglefavorite', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: _launchDn, package: a.package, displayName: a.displayName, favorite: newFav }) }).catch(function() {});
        });
      })(app, starBtn);

      var nameEl = document.createElement('span');
      nameEl.className = 'lm-app-name';
      nameEl.textContent = app.displayName || app.package;
      nameEl.title = app.package;

      var launchBtn = document.createElement('button');
      launchBtn.className = 'lm-launch-btn';
      launchBtn.innerHTML = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg> Launch';
      (function(a, lb) {
        lb.addEventListener('click', function() { launchApp(_launchDn, a.package, a.displayName, lb); });
      })(app, launchBtn);

      row.appendChild(starBtn);
      row.appendChild(nameEl);
      row.appendChild(launchBtn);
      list.appendChild(row);
    }

    function launchApp(dn, pkg, displayName, btn) {
      if (!dn || !pkg) return;
      if (btn) btn.disabled = true;
      var statusEl = document.getElementById('lm-status');
      statusEl.textContent = 'Launching ' + (displayName || pkg) + '...';
      statusEl.className   = 'lm-status';
      fetch('/api/launchapp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: dn, package: pkg })
      })
      .then(function(r) { return r.json(); })
      .then(function(j) {
        statusEl.textContent = j.ok ? (displayName || pkg) + ' launched successfully.' : 'Failed to launch ' + (displayName || pkg) + '.';
        statusEl.className   = 'lm-status ' + (j.ok ? 'ok' : 'err');
        if (btn) btn.disabled = false;
        if (j.ok) setTimeout(function() { statusEl.textContent = ''; statusEl.className = 'lm-status'; }, 3000);
      })
      .catch(function() {
        statusEl.textContent = 'Error communicating with server.';
        statusEl.className   = 'lm-status err';
        if (btn) btn.disabled = false;
      });
    }

    document.getElementById('lm-close').addEventListener('click', closeLaunchModal);
    document.getElementById('launch-modal').addEventListener('click', function(e) { if (e.target === this) closeLaunchModal(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && _launchDn) closeLaunchModal(); });

    document.getElementById('lm-show-all-btn').addEventListener('click', function() {
      if (_allAppsLoaded || !_launchDn) return;
      var btn = this;
      btn.disabled = true;
      btn.textContent = 'Loading installed apps...';
      var statusEl = document.getElementById('lm-status');
      statusEl.textContent = 'Fetching app list from headset...';
      statusEl.className   = 'lm-status';
      fetch('/api/installedapps?name=' + encodeURIComponent(_launchDn))
        .then(function(r) { return r.json(); })
        .then(function(apps) {
          _allAppsLoaded = true;
          apps.forEach(function(a) { if (a.displayName) appNameCache[a.package] = a.displayName; if (a.favorite) _favoritePackages[a.package] = true; });
          btn.style.display = 'none';
          statusEl.textContent = '';
          statusEl.className   = 'lm-status';
          var list = document.getElementById('lm-list');
          list.innerHTML = '';
          var metaHomePkg = 'com.oculus.vrshell';
          var metaApp = apps.find(function(a) { return a.package === metaHomePkg; }) || { package: metaHomePkg, displayName: 'Meta Home', favorite: true };
          var favApps   = apps.filter(function(a) { return a.package !== metaHomePkg && _favoritePackages[a.package]; });
          var otherApps = apps.filter(function(a) { return a.package !== metaHomePkg && !_favoritePackages[a.package]; });
          function addSection(label) { var s = document.createElement('div'); s.className = 'lm-section-label'; s.textContent = label; list.appendChild(s); }
          addSection('Meta Home'); renderAppRow(metaApp, list);
          if (favApps.length)   { addSection('Favorites'); favApps.forEach(function(a)   { renderAppRow(a, list); }); }
          if (otherApps.length) { addSection('All Apps');  otherApps.forEach(function(a) { renderAppRow(a, list); }); }
        })
        .catch(function() {
          btn.disabled = false;
          btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg> Show all installed apps';
          statusEl.textContent = 'Could not load app list.';
          statusEl.className   = 'lm-status err';
        });
    });

    // ── CSV polling ──────────────────────────────────────────────────────────
    function pollCsv() {
      fetch(CSV_PATH + '?_=' + Date.now())
        .then(function(r) { if (!r.ok) throw new Error(r.status); return r.text(); })
        .then(function(text) {
          var rows = parseCsv(text);
          var newStatus = {};
          rows.forEach(function(row) {
            var dn = toDisplayName(row['Name'] || '');
            if (!dn) return;
            newStatus[dn] = {
              ping:       (row['Ping']  || '').toLowerCase() === 'true',
              scrcpy:     (row['SCRCPY'] || '').toLowerCase() === 'ok',
              runningApp: row['RunningApp'] || ''
            };
          });
          headsetStatus = newStatus;
          updateRunningApps();
          if (!initialFilterApplied) {
            initialFilterApplied = true;
            var anyActive = Object.keys(headsetVisible).some(function(dn) {
              return (headsetStatus[dn] || { scrcpy: false }).scrcpy;
            });
            if (anyActive) {
              Object.keys(headsetVisible).forEach(function(dn) {
                var stat = headsetStatus[dn] || { scrcpy: false };
                setHeadsetVisible(dn, stat.scrcpy);
              });
              TopBar.setActiveFilter('scrcpy');
            } else {
              Object.keys(headsetVisible).forEach(function(dn) { setHeadsetVisible(dn, true); });
              TopBar.setActiveFilter('all');
            }
          }
          applyOfflineState();
        })
        .catch(function() { /* keep last known state on network error */ });;
    }

    // ── Running app badges ────────────────────────────────────────────────────
    function updateRunningApps() {
      document.querySelectorAll('.running-app').forEach(function(el) {
        var dn  = el.dataset.runningApp;
        var pkg = (headsetStatus[dn] || {}).runningApp || '';
        if (!pkg) { el.classList.add('hidden'); return; }
        var displayName = appNameCache[pkg] || pkg;
        // Trim 'com.' prefix if no display name resolved
        if (displayName === pkg && pkg.indexOf('.') !== -1) {
          var parts = pkg.split('.');
          displayName = parts[parts.length - 1];
        }
        el.querySelector('.running-app-name').textContent = displayName;
        el.classList.remove('hidden');
      });
    }

    // ── Video aspect ratio detection (removes black bands) ───────────────────
    var _detectedRatios = {};
    function adaptCellAspectRatio(cell) {
      var dn = cell.dataset.display;
      if (_detectedRatios[dn]) return; // already adapted
      var frame = cell.querySelector('.video-frame');
      if (!frame) return;
      try {
        var doc = frame.contentWindow && frame.contentWindow.document;
        if (!doc) return;
        var video = doc.querySelector('video');
        if (video && video.videoWidth > 0 && video.videoHeight > 0) {
          var ratio = (video.videoWidth / video.videoHeight).toFixed(4);
          _detectedRatios[dn] = ratio;
          cell.style.aspectRatio = ratio;
          applyScale();
        }
      } catch(e) {}
    }

    // ── Offline / no-stream state update ─────────────────────────────────────
    function applyOfflineState() {
      var scaleNeeded = false;
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn        = cell.dataset.display;
        var stat      = headsetStatus[dn] || { ping: false, scrcpy: false };
        var wasStream = !cell.classList.contains('no-stream');
        var streaming = stat.scrcpy;

        cell.classList.toggle('offline',   !stat.ping);
        if (wasStream !== streaming) scaleNeeded = true;
        cell.classList.toggle('no-stream', !streaming);
        if (!streaming) cell.style.width = ''; // clear layout width for compact offline tile

        // Manage video-frame src: load only when streaming, clear otherwise
        var videoFrame  = cell.querySelector('.video-frame');
        var expectedSrc = dn + '[video].html';
        if (videoFrame) {
          var curSrc = videoFrame.getAttribute('src') || '';
          if (streaming && curSrc !== expectedSrc) {
            videoFrame.setAttribute('src', expectedSrc);
            delete _detectedRatios[dn]; // reset so ratio is re-detected on new stream
            cell.style.aspectRatio = '16 / 9'; // reset to default until detected
          } else if (!streaming && curSrc !== '') {
            videoFrame.setAttribute('src', ''); // stop loading stream
          }
        }

        var btn = document.querySelector('[data-headset="' + dn + '"]');
        if (btn) btn.classList.toggle('offline', !stat.scrcpy);
        var compactItem = document.querySelector('[data-compact-headset="' + dn + '"]');
        if (compactItem) compactItem.classList.toggle('offline', !stat.scrcpy);
      });
      if (scaleNeeded) { applyLayout(); applyScale(); }
    }

    // ── Scale status overlays ────────────────────────────────────────────────
    function applyScale() {
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var isNoStream = cell.classList.contains('no-stream');
        // Streaming: status overlay is 1/3 of cell width; no-stream: fills entire cell
        var wrapperW = isNoStream ? cell.offsetWidth : (cell.offsetWidth / 3);
        var scale = wrapperW / NATURAL_W;
        cell.querySelectorAll('.status-frame').forEach(function(fr) {
          fr.style.width     = NATURAL_W + 'px';
          fr.style.height    = NATURAL_H + 'px';
          fr.style.transform = 'scale(' + scale + ')';
        });
      });
    }

    // ── Viewport-fit layout: compute optimal columns so videos fit in the window ─
    function applyLayout() {
      var topbar = document.querySelector('.topbar');
      var topbarH = topbar ? (topbar.offsetHeight + 1) : 47;
      var gap = 6;
      var padding = gap;
      var availW = window.innerWidth;
      var availH = window.innerHeight - topbarH;
      var innerW = availW - padding * 2;
      var innerH = availH - padding * 2;

      var streamCells = Array.from(document.querySelectorAll('#grid .cell:not(.hidden):not(.no-stream)'));
      var N = streamCells.length;
      if (N === 0) return;

      var bestArea = 0;
      var bestCellW = Math.min(innerW, innerH * 16 / 9);

      for (var c = 1; c <= N; c++) {
        var r = Math.ceil(N / c);
        var cellW = (innerW - gap * (c - 1)) / c;
        var cellH = cellW * 9 / 16;
        if (cellH * r + gap * (r - 1) > innerH) {
          // Height-constrained: scale down to fit
          cellH = (innerH - gap * (r - 1)) / r;
          cellW = cellH * 16 / 9;
        }
        var area = cellW * cellH;
        if (area > bestArea) {
          bestArea = area;
          bestCellW = cellW;
        }
      }

      var w = Math.floor(bestCellW);
      streamCells.forEach(function(cell) { cell.style.width = w + 'px'; });
    }

    // ── Status overlay toggle ────────────────────────────────────────────────
    var statusVisible = true;
    var statusToggleBtn = document.getElementById('status-toggle');
    statusToggleBtn.style.color = 'var(--filter-active-bg)';
    statusToggleBtn.addEventListener('click', function() {
      statusVisible = !statusVisible;
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        cell.classList.toggle('status-hidden', !statusVisible);
      });
      this.style.color = statusVisible ? 'var(--filter-active-bg)' : '';
    });

    // ── Boot ─────────────────────────────────────────────────────────────────
    TopBar.initCompact();
    TopBar.initManageDevicesBtn();
    buildHeadsetToggles();

    var ro = new ResizeObserver(function() { applyLayout(); applyScale(); });
    ro.observe(document.getElementById('grid'));
    window.addEventListener('resize', function() { applyLayout(); applyScale(); });

    document.addEventListener('DOMContentLoaded', function() {
      applyLayout();
      applyScale();
      pollCsv();
      setInterval(pollCsv, REFRESH_MS);
      pollHeadsetsCsv();
      setInterval(pollHeadsetsCsv, 10000);
      // Check monitoring HTML existence and pre-load favorite app names
      document.querySelectorAll('#grid .cell').forEach(function(cell) {
        var dn = cell.dataset.display;
        if (!dn) return;
        fetch('/api/favoriteapps?name=' + encodeURIComponent(dn))
          .then(function(r) { return r.json(); })
          .then(function(favs) { favs.forEach(function(a) { if (a.package && a.displayName) appNameCache[a.package] = a.displayName; }); })
          .catch(function() {});
      });
      // Periodically detect actual video dimensions to eliminate black bands
      setInterval(function() {
        document.querySelectorAll('#grid .cell:not(.no-stream)').forEach(adaptCellAspectRatio);
      }, 1500);

      // Reload monitoring iframes when the file changes (Last-Modified polling)
      var _monLastModified = {};
      setInterval(function() {
        document.querySelectorAll('#grid .cell .status-frame').forEach(function(fr) {
          var cell = fr.closest('.cell');
          if (!cell) return;
          var dn  = cell.dataset.display;
          var url = dn + '[monitoring].html';
          fetch(url, { method: 'HEAD', cache: 'no-store' })
            .then(function(r) {
              var lm = r.headers.get('Last-Modified') || r.headers.get('ETag') || '';
              if (lm && lm !== _monLastModified[dn]) {
                _monLastModified[dn] = lm;
                fr.src = url + '?_=' + Date.now();
              }
            })
            .catch(function() {});
        });
      }, REFRESH_MS);
    });
  </script>
</body>
</html>
