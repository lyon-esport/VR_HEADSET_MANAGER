<!doctype html>
<html lang="en" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <title><%= $name %> - Timer</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">

    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        background: transparent !important;
        overflow: hidden;
      }
      body {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #timer-val {
        display: none;
        color: #fff;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        font-weight: 700;
        /* Fixed size (not vh-relative): text size no longer depends on the OBS source
           box dimensions, so the box can be sized to snugly fit the text instead of
           always leaving proportional empty margins. See docs_timer_api.md for the
           recommended OBS Browser Source width/height for this font-size. */
        font-size: 56px;
        padding: 4px 14px;
        letter-spacing: 0.03em;
        white-space: nowrap;
        text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      }
      #timer-val.visible { display: block; }
    </style>
  </head>
  <body>
    <div id="timer-val"></div>

    <script src="assets/live_events.js"></script>
    <script>
      var TIMER_ID = '<%= $headset_id %>';

      // This overlay used to fetch /api/timer every second, from every OBS Browser
      // source pointing at it - the single biggest request generator in the app.
      //
      // A running timer's displayed value changes every second with NO database write,
      // so a change counter cannot announce it and SSE alone cannot drive the display.
      // The split: fetch the STATE, tick it LOCALLY, and only resync. Start / stop /
      // pause / reset all write the timer row, so those arrive as a headset_timers
      // nudge and correct the display immediately.
      var TICK_MS          = 1000;    // local repaint - visually identical to before
      var RESYNC_ACTIVE_MS = 5000;    // safety resync while running (bounds any drift)
      var RESYNC_IDLE_MS   = 30000;   // safety resync while stopped

      var st = { active: false, paused: false, mode: 'dec', base: null, at: 0, raw: '' };

      function pad2(n) { return (n < 10 ? '0' : '') + n; }

      function parseVal(v) {
        if (!v) { return null; }
        var parts = String(v).trim().split(':');
        var total = 0;
        for (var i = 0; i < parts.length; i++) {
          var n = parseInt(parts[i], 10);
          if (isNaN(n)) { return null; }
          total = total * 60 + n;
        }
        return total;
      }

      // Mirrors the server's '{0:D2}:{1:D2}' exactly - minutes are NOT wrapped into
      // hours, so a 120-minute timer reads 120:00 there and here.
      function fmt(total) {
        if (total < 0) { total = 0; }
        return pad2(Math.floor(total / 60)) + ':' + pad2(total % 60);
      }

      function paint() {
        var el = document.getElementById('timer-val');
        if (!el) { return; }
        if (!st.active || st.raw === '') { el.classList.remove('visible'); return; }
        var text = st.raw;
        if (!st.paused && st.base !== null) {
          var elapsed = Math.floor((Date.now() - st.at) / 1000);
          text = fmt(st.mode === 'inc' ? st.base + elapsed : st.base - elapsed);
        }
        el.textContent = text;
        el.classList.add('visible');
      }

      function fetchState() {
        return fetch('/api/timer?id=' + encodeURIComponent(TIMER_ID) + '&action=status&_=' + Date.now(), { cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (!j) { return; }
            st.active = !!j.active;
            st.paused = !!j.paused;
            st.mode   = j.mode || 'dec';
            st.raw    = (j.value || '').trim();
            st.base   = parseVal(st.raw);
            st.at     = Date.now();
            paint();
          })
          .catch(function () {});
      }

      function resyncLoop() {
        fetchState().finally(function () {
          setTimeout(resyncLoop, st.active ? RESYNC_ACTIVE_MS : RESYNC_IDLE_MS);
        });
      }

      if (window.LiveEvents) { LiveEvents.subscribe('headset_timers', fetchState); }
      resyncLoop();
      setInterval(paint, TICK_MS);
    </script>
  </body>
</html>
