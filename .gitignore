# ignore all logs
**/logs
*.logs

# ignore config files
config/
/*.json
!/templates/*

# ignore user data
/data/

# ignore generated html files
website/generated/
website/timer/*
website/assets/app_icons/*



# ignore records
records/*

# ignore scrcpy tests
scrcpy_manualScripts/

# ignore non-regression test reports and evidence (screenshots, logs, ffprobe
# dumps saved per run) - local to the machine that ran the harness
scripts/nonRegressionTests/reports/
scripts/dbTests/reports/

# ignore large sources
/sources/ffmpeg-8.1-essentials_build.zip
/sources/ffmpeg*
/sources/Archives/

#Web and app data
/app_icons

Exclude .md files but include docs md files
*.md
!/docs/*.md
!/README.md

# ignore Architecture Decision Records - local design history, deliberately
# not versioned and not shipped (also excluded in scripts/.releaseinclude)
/docs/adr/
/docs/improvement_plan/

# ignore devlog history - raw prompts/plans per feature, local dev-only
# scratch archive, deliberately not versioned and not shipped
/.dev/

#Other...
desktop.ini
.vscode
OBS/timer/
.gdoc
/.github/
/.claude/
*_test.ps1
/version.txt
